{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=EmployeeManagementDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Reporting": {
    "Provider": "Native",
    "BaseUrl": "https://localhost:44363"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/employee-management-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "Database": {
    "SeedDemoData": false
  },
  "SeedAdmin": {
    "Email": ""
  },
  "Payroll": {
    "Deductions": {
      "SssEmployeeRate": 0,
      "PhilHealthEmployeeRate": 0,
      "PagIbigEmployeeRate": 0,
      "PagIbigMaximumContribution": 0,
      "CalculateWithholdingTax": false
    },
    "TaxBrackets": []
  }
}
