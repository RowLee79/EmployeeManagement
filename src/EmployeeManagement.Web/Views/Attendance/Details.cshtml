@model EmployeeManagement.Application.Attendance.Models.AttendanceDetailsModel

@{
    ViewData["Title"] = "Attendance Details";
}

<div class="page-header">

    <div>
        <h1>Attendance Details</h1>
        <p>View employee attendance information.</p>
    </div>

    <div class="d-flex gap-2">

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">

            <i class="bi bi-pencil me-1"></i>
            Edit

        </a>

        <a asp-action="Index"
           class="btn btn-light">

            Back

        </a>

    </div>

</div>


<div class="row g-4">

    <div class="col-lg-8">

        <div class="card shadow-sm border-0">

            <div class="card-body">

                <div class="d-flex align-items-center
                    gap-3 mb-4">

                    <div class="avatar avatar-lg">
                        @GetInitials(Model.EmployeeName)
                    </div>

                    <div>

                        <h4 class="mb-1">
                            @Model.EmployeeName
                        </h4>

                        <div class="text-muted">
                            @Model.EmployeeNumber
                        </div>

                    </div>

                </div>


                <div class="row g-4">

                    <div class="col-md-6">

                        <small class="text-muted">
                            Attendance Date
                        </small>

                        <div class="fw-semibold">
                            @Model.AttendanceDate
                            .ToString("MMMM dd, yyyy")
                        </div>

                    </div>


                    <div class="col-md-6">

                        <small class="text-muted">
                            Status
                        </small>

                        <div class="fw-semibold">
                            @Model.Status
                        </div>

                    </div>


                    <div class="col-md-6">

                        <small class="text-muted">
                            Time In
                        </small>

                        <div class="fw-semibold">
                            @(Model.TimeIn?
                                .ToString(@"hh\:mm")
                                ?? "—")
                        </div>

                    </div>


                    <div class="col-md-6">

                        <small class="text-muted">
                            Time Out
                        </small>

                        <div class="fw-semibold">
                            @(Model.TimeOut?
                                .ToString(@"hh\:mm")
                                ?? "—")
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="col-lg-4">

        <div class="card shadow-sm border-0">

            <div class="card-body">

                <h5 class="mb-4">
                    Work Summary
                </h5>


                <div class="d-flex
                    justify-content-between
                    mb-3">

                    <span>
                        Regular Hours
                    </span>

                    <strong>
                        @Model.RegularHours.ToString("0.00") h
                    </strong>

                </div>


                <div class="d-flex
                    justify-content-between
                    mb-3">

                    <span>
                        Overtime
                    </span>

                    <strong>
                        @Model.OvertimeHours.ToString("0.00") h
                    </strong>

                </div>


                <div class="d-flex
                    justify-content-between
                    mb-3">

                    <span>
                        Late
                    </span>

                    <strong>
                        @Model.LateMinutes min
                    </strong>

                </div>


                <div class="d-flex
                    justify-content-between">

                    <span>
                        Undertime
                    </span>

                    <strong>
                        @Model.UndertimeMinutes min
                    </strong>

                </div>

            </div>

        </div>

    </div>

</div>


@functions {

    private string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "?";

        var parts =
            fullName
                .Split(
                    ' ',
                    StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
            return parts[0][0]
                .ToString()
                .ToUpperInvariant();

        return $"{parts[0][0]}{parts[^1][0]}"
            .ToUpperInvariant();
    }

}