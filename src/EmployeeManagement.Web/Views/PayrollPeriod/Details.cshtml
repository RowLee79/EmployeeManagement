@using EmployeeManagement.Application.Payroll
@using EmployeeManagement.Application.Payroll.Models

@model PayrollPeriodDetailsModel

@{
    ViewData["Title"] = "Payroll Period Details";

    var statusClass =
        Model.Status switch
        {
            PayrollPeriodStatuses.Open
                => "bg-primary",

            PayrollPeriodStatuses.Processing
                => "bg-warning text-dark",

            PayrollPeriodStatuses.Approved
                => "bg-info text-dark",

            PayrollPeriodStatuses.Finalized
                => "bg-success",

            PayrollPeriodStatuses.Closed
                => "bg-secondary",

            PayrollPeriodStatuses.Locked
                => "bg-dark",

            _ => "bg-light text-dark"
        };

    var statusIcon =
        Model.Status switch
        {
            PayrollPeriodStatuses.Open
                => "bi-unlock",

            PayrollPeriodStatuses.Processing
                => "bi-hourglass-split",

            PayrollPeriodStatuses.Approved
                => "bi-check-circle",

            PayrollPeriodStatuses.Finalized
                => "bi-check2-all",

            PayrollPeriodStatuses.Closed
                => "bi-lock",

            PayrollPeriodStatuses.Locked
                => "bi-shield-lock",

            _ => "bi-question-circle"
        };

    var canEdit =
        Model.Status == PayrollPeriodStatuses.Open;

    var canDelete =
        Model.Status == PayrollPeriodStatuses.Open &&
        Model.PayrollCount == 0;

    var canGeneratePayroll =
        Model.Status == PayrollPeriodStatuses.Open;

    var canStartProcessing =
        Model.Status == PayrollPeriodStatuses.Open;

    var canApprove =
        Model.Status == PayrollPeriodStatuses.Processing;

    var canFinalize =
        Model.Status == PayrollPeriodStatuses.Approved;

    var canClose =
        Model.Status == PayrollPeriodStatuses.Finalized;

    var canLock =
        Model.Status == PayrollPeriodStatuses.Closed;
}

<div class="container-fluid">

    <!-- ========================================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex flex-wrap
        justify-content-between
        align-items-center mb-4">

        <div>

            <div class="d-flex
                flex-wrap
                align-items-center
                gap-2 mb-1">

                <h2 class="mb-0">

                    <i class="bi bi-calendar-range me-2"></i>

                    Payroll Period Details

                </h2>

                <span class="badge @statusClass">

                    <i class="bi @statusIcon me-1"></i>

                    @Model.Status

                </span>

            </div>

            <div class="text-muted">

                @Model.PeriodCode

            </div>

        </div>


        <div class="d-flex
            flex-wrap
            gap-2
            mt-3
            mt-md-0">

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>

                Back to Payroll Periods

            </a>


            @if (canEdit)
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">

                    <i class="bi bi-pencil me-1"></i>

                    Edit

                </a>
            }

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- TEMP DATA MESSAGES -->
    <!-- ========================================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success
            alert-dismissible
            fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger
            alert-dismissible
            fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- PERIOD INFORMATION -->
    <!-- ========================================================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">

                <i class="bi bi-calendar3 me-2"></i>

                Period Information

            </h5>

        </div>


        <div class="card-body">

            <div class="row g-4">

                <!-- Period Code -->

                <div class="col-md-6 col-lg-3">

                    <div class="text-muted small">
                        Period Code
                    </div>

                    <div class="fw-bold fs-5">

                        @Model.PeriodCode

                    </div>

                </div>


                <!-- Start Date -->

                <div class="col-md-6 col-lg-3">

                    <div class="text-muted small">
                        Start Date
                    </div>

                    <div class="fw-semibold">

                        @Model.StartDate.ToString("dd-MMM-yyyy")

                    </div>

                </div>


                <!-- End Date -->

                <div class="col-md-6 col-lg-3">

                    <div class="text-muted small">
                        End Date
                    </div>

                    <div class="fw-semibold">

                        @Model.EndDate.ToString("dd-MMM-yyyy")

                    </div>

                </div>


                <!-- Pay Date -->

                <div class="col-md-6 col-lg-3">

                    <div class="text-muted small">
                        Pay Date
                    </div>

                    <div class="fw-semibold">

                        @Model.PayDate.ToString("dd-MMM-yyyy")

                    </div>

                </div>


                <!-- Status -->

                <div class="col-md-6 col-lg-3">

                    <div class="text-muted small">
                        Status
                    </div>

                    <div>

                        <span class="badge @statusClass fs-6">

                            <i class="bi @statusIcon me-1"></i>

                            @Model.Status

                        </span>

                    </div>

                </div>


                <!-- Description -->

                <div class="col-md-6 col-lg-9">

                    <div class="text-muted small">
                        Description
                    </div>

                    <div>

                        @(string.IsNullOrWhiteSpace(Model.Description)
                            ? "No description provided."
                            : Model.Description)

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- PAYROLL SUMMARY -->
    <!-- ========================================================= -->

    <div class="row g-4 mb-4">

        <!-- Payroll Count -->

        <div class="col-md-6 col-xl-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>

                            <div class="text-muted small">
                                Payroll Records
                            </div>

                            <div class="fs-3 fw-bold">

                                @Model.PayrollCount

                            </div>

                        </div>

                        <div class="fs-2 text-primary">

                            <i class="bi bi-people"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Gross Salary -->

        <div class="col-md-6 col-xl-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Total Gross Salary
                    </div>

                    <div class="fs-4 fw-bold">

                        ₱@Model.TotalGrossSalary.ToString("N2")

                    </div>

                </div>

            </div>

        </div>


        <!-- Deductions -->

        <div class="col-md-6 col-xl-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Total Deductions
                    </div>

                    <div class="fs-4 fw-bold text-danger">

                        ₱@Model.TotalDeductions.ToString("N2")

                    </div>

                </div>

            </div>

        </div>


        <!-- Net Salary -->

        <div class="col-md-6 col-xl-3">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small">
                        Total Net Salary
                    </div>

                    <div class="fs-4 fw-bold text-success">

                        ₱@Model.TotalNetSalary.ToString("N2")

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- PAYROLL GENERATION -->
    <!-- ========================================================= -->
    @if (canGeneratePayroll)
    {
        <div class="card shadow-sm mb-4 border-primary">

            <div class="card-header
                bg-primary
                text-white">

                <h5 class="mb-0">

                    <i class="bi bi-people me-2"></i>

                    Generate Payroll

                </h5>

            </div>


            <div class="card-body">

                <div class="row align-items-center">

                    <div class="col-lg-8">

                        <h5>
                            Generate payroll for this period
                        </h5>

                        <p class="text-muted mb-lg-0">

                            This will create payroll records
                            for all active employees who do not
                            already have payroll records in this
                            period.

                        </p>

                    </div>


                    <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">

                        <form asp-controller="Payroll"
                              asp-action="Generate"
                              asp-route-payrollPeriodId="@Model.Id"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-primary btn-lg"
                                    onclick="return confirm(
                                'Generate payroll for all active employees in this payroll period?');">

                                <i class="bi bi-people-fill me-1"></i>

                                Generate Payroll

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    }


    <!-- ========================================================= -->
    <!-- WORKFLOW -->
    <!-- ========================================================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">

                <i class="bi bi-diagram-3 me-2"></i>

                Payroll Period Workflow

            </h5>

        </div>


        <div class="card-body">

            <div class="row g-3 text-center">

                <!-- OPEN -->

                <div class="col-6 col-md">

                    <div class="p-3 rounded
                        @(Model.Status == PayrollPeriodStatuses.Open
                            ? "bg-primary text-white"
                            : "bg-light")">

                        <i class="bi bi-unlock fs-3"></i>

                        <div class="fw-semibold mt-2">
                            Open
                        </div>

                    </div>

                </div>


                <!-- PROCESSING -->

                <div class="col-6 col-md">

                    <div class="p-3 rounded
                        @(Model.Status ==
                          PayrollPeriodStatuses.Processing
                            ? "bg-warning text-dark"
                            : "bg-light")">

                        <i class="bi bi-hourglass-split fs-3"></i>

                        <div class="fw-semibold mt-2">
                            Processing
                        </div>

                    </div>

                </div>


                <!-- APPROVED -->

                <div class="col-6 col-md">

                    <div class="p-3 rounded
                        @(Model.Status ==
                          PayrollPeriodStatuses.Approved
                            ? "bg-info text-dark"
                            : "bg-light")">

                        <i class="bi bi-check-circle fs-3"></i>

                        <div class="fw-semibold mt-2">
                            Approved
                        </div>

                    </div>

                </div>


                <!-- FINALIZED -->

                <div class="col-6 col-md">

                    <div class="p-3 rounded
                        @(Model.Status ==
                          PayrollPeriodStatuses.Finalized
                            ? "bg-success text-white"
                            : "bg-light")">

                        <i class="bi bi-check2-all fs-3"></i>

                        <div class="fw-semibold mt-2">
                            Finalized
                        </div>

                    </div>

                </div>


                <!-- CLOSED -->

                <div class="col-6 col-md">

                    <div class="p-3 rounded
                        @(Model.Status ==
                          PayrollPeriodStatuses.Closed
                            ? "bg-secondary text-white"
                            : "bg-light")">

                        <i class="bi bi-lock fs-3"></i>

                        <div class="fw-semibold mt-2">
                            Closed
                        </div>

                    </div>

                </div>


                <!-- LOCKED -->

                <div class="col-6 col-md">

                    <div class="p-3 rounded
                        @(Model.Status ==
                          PayrollPeriodStatuses.Locked
                            ? "bg-dark text-white"
                            : "bg-light")">

                        <i class="bi bi-shield-lock fs-3"></i>

                        <div class="fw-semibold mt-2">
                            Locked
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- AVAILABLE ACTIONS -->
    <!-- ========================================================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">

                <i class="bi bi-lightning me-2"></i>

                Available Actions

            </h5>

        </div>


        <div class="card-body">

            <div class="d-flex flex-wrap gap-2">

                <!-- Edit -->
                @if (canEdit)
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">

                        <i class="bi bi-pencil me-1"></i>

                        Edit

                    </a>
                }


                <!-- Generate Payroll -->
                @if (canGeneratePayroll)
                {
                    <form asp-controller="Payroll"
                          asp-action="Generate"
                          asp-route-payrollPeriodId="@Model.Id"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-primary"
                                onclick="return confirm(
                            'Generate payroll for all active employees in this payroll period?');">

                            <i class="bi bi-people-fill me-1"></i>

                            Generate Payroll

                        </button>

                    </form>
                }


                <!-- Start Processing -->
                @if (canStartProcessing)
                {
                    <form asp-action="StartProcessing"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-warning"
                                onclick="return confirm(
                            'Start processing this payroll period?');">

                            <i class="bi bi-play-circle me-1"></i>

                            Start Processing

                        </button>

                    </form>
                }


                <!-- Approve -->
                @if (canApprove)
                {
                    <form asp-action="Approve"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-info"
                                onclick="return confirm(
                            'Approve this payroll period?');">

                            <i class="bi bi-check-circle me-1"></i>

                            Approve

                        </button>

                    </form>
                }


                <!-- Finalize -->
                @if (canFinalize)
                {
                    <form asp-action="Finalize"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-success"
                                onclick="return confirm(
                            'Finalize this payroll period?');">

                            <i class="bi bi-check2-all me-1"></i>

                            Finalize

                        </button>

                    </form>
                }


                <!-- Close -->
                @if (canClose)
                {
                    <form asp-action="Close"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-secondary"
                                onclick="return confirm(
                            'Close this payroll period?');">

                            <i class="bi bi-lock me-1"></i>

                            Close

                        </button>

                    </form>
                }


                <!-- Lock -->
                @if (canLock)
                {
                    <form asp-action="Lock"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-dark"
                                onclick="return confirm(
                            'Lock this payroll period? A locked period cannot be changed.');">

                            <i class="bi bi-shield-lock me-1"></i>

                            Lock

                        </button>

                    </form>
                }


                <!-- Delete -->
                @if (canDelete)
                {
                    <form asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-danger"
                                onclick="return confirm(
                            'Delete this payroll period? This action cannot be undone.');">

                            <i class="bi bi-trash me-1"></i>

                            Delete

                        </button>

                    </form>
                }


                <!-- Back -->

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-left me-1"></i>

                    Back

                </a>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- PAYROLL SUMMARY INFORMATION -->
    <!-- ========================================================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">

                <i class="bi bi-bar-chart me-2"></i>

                Payroll Summary

            </h5>

        </div>


        <div class="card-body">

            @if (Model.PayrollCount == 0)
            {
                <div class="text-center py-4">

                    <i class="bi bi-inbox
                        display-5
                        text-muted">
                    </i>

                    <h5 class="mt-3">
                        No Payroll Records
                    </h5>

                    <p class="text-muted mb-0">

                        No payroll records have been generated
                        for this payroll period yet.

                    </p>

                    @if (canGeneratePayroll)
                    {
                        <div class="mt-3">

                            <form asp-controller="Payroll"
                                  asp-action="Generate"
                                  asp-route-payrollPeriodId="@Model.Id"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-primary"
                                        onclick="return confirm(
                                    'Generate payroll for all active employees in this payroll period?');">

                                    <i class="bi bi-people-fill me-1"></i>

                                    Generate Payroll

                                </button>

                            </form>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="row g-4">

                    <div class="col-md-4">

                        <div class="text-muted small">
                            Payroll Records
                        </div>

                        <div class="fs-4 fw-bold">

                            @Model.PayrollCount

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="text-muted small">
                            Total Gross Salary
                        </div>

                        <div class="fs-4 fw-bold">

                            ₱@Model.TotalGrossSalary.ToString("N2")

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="text-muted small">
                            Total Net Salary
                        </div>

                        <div class="fs-4 fw-bold text-success">

                            ₱@Model.TotalNetSalary.ToString("N2")

                        </div>

                    </div>

                </div>

            }

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- STATUS INFORMATION -->
    <!-- ========================================================= -->

    <div class="alert
        @(Model.Status == PayrollPeriodStatuses.Locked
            ? "alert-dark"
            : Model.Status == PayrollPeriodStatuses.Closed
                ? "alert-secondary"
                : Model.Status == PayrollPeriodStatuses.Finalized
                    ? "alert-success"
                    : Model.Status == PayrollPeriodStatuses.Approved
                        ? "alert-info"
                        : Model.Status == PayrollPeriodStatuses.Processing
                            ? "alert-warning"
                            : "alert-primary")">

        <div class="d-flex align-items-start">

            <i class="bi @statusIcon
                fs-4
                me-3">
            </i>

            <div>

                @if (Model.Status ==
                     PayrollPeriodStatuses.Open)
                {
                    <strong>
                        Payroll Period is Open
                    </strong>

                    <div>
                        You can edit the period and generate
                        payroll records for active employees.
                    </div>
                }
                else if (Model.Status ==
                         PayrollPeriodStatuses.Processing)
                {
                    <strong>
                        Payroll Period is Processing
                    </strong>

                    <div>
                        Payroll processing is in progress.
                        Review the generated payroll records
                        before approving the period.
                    </div>
                }
                else if (Model.Status ==
                         PayrollPeriodStatuses.Approved)
                {
                    <strong>
                        Payroll Period is Approved
                    </strong>

                    <div>
                        The payroll period has been approved
                        and can now be finalized.
                    </div>
                }
                else if (Model.Status ==
                         PayrollPeriodStatuses.Finalized)
                {
                    <strong>
                        Payroll Period is Finalized
                    </strong>

                    <div>
                        Payroll processing has been finalized.
                        The period can now be closed.
                    </div>
                }
                else if (Model.Status ==
                         PayrollPeriodStatuses.Closed)
                {
                    <strong>
                        Payroll Period is Closed
                    </strong>

                    <div>
                        The period is closed and can be locked
                        to prevent further changes.
                    </div>
                }
                else if (Model.Status ==
                         PayrollPeriodStatuses.Locked)
                {
                    <strong>
                        Payroll Period is Locked
                    </strong>

                    <div>
                        This payroll period is locked and should
                        no longer be modified.
                    </div>
                }

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- DELETE WARNING -->
    <!-- ========================================================= -->
    @if (Model.Status == PayrollPeriodStatuses.Open &&
             Model.PayrollCount > 0)
    {
        <div class="alert alert-warning">

            <i class="bi bi-exclamation-triangle me-2"></i>

            <strong>
                This payroll period cannot be deleted.
            </strong>

            It already contains
            <strong>@Model.PayrollCount</strong>
            payroll record(s).

        </div>
    }

</div>