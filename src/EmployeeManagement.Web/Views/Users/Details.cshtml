@model EmployeeManagement.Application.Users.Models.UserDetailsModel

@{
    ViewData["Title"] = "User Details";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between
        align-items-center mb-4">

        <div>

            <h1 class="h3 mb-1">
                User Details
            </h1>

            <p class="text-muted mb-0">
                View account information and access.
            </p>

        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                <i class="bi bi-pencil me-1"></i>

                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                Back

            </a>

        </div>

    </div>


    <div class="row g-4">

        <!-- Account -->

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-transparent">

                    <h5 class="mb-0">
                        Account Information
                    </h5>

                </div>

                <div class="card-body">

                    <dl class="row mb-0">

                        <dt class="col-sm-4">
                            Name
                        </dt>

                        <dd class="col-sm-8">
                            @Model.FirstName
                            @Model.LastName
                        </dd>


                        <dt class="col-sm-4">
                            Email
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Email
                        </dd>


                        <dt class="col-sm-4">
                            Username
                        </dt>

                        <dd class="col-sm-8">
                            @Model.UserName
                        </dd>


                        <dt class="col-sm-4">
                            Phone
                        </dt>

                        <dd class="col-sm-8">
                            @(Model.PhoneNumber ?? "N/A")
                        </dd>


                        <dt class="col-sm-4">
                            Email Confirmed
                        </dt>

                        <dd class="col-sm-8">

                            @if (Model.EmailConfirmed)
                            {
                                <span class="badge text-bg-success">
                                    Confirmed
                                </span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">
                                    Not Confirmed
                                </span>
                            }

                        </dd>


                        <dt class="col-sm-4">
                            Status
                        </dt>

                        <dd class="col-sm-8">

                            @if (Model.IsActive)
                            {
                                <span class="badge text-bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">
                                    Inactive
                                </span>
                            }

                        </dd>


                        <dt class="col-sm-4">
                            Employee
                        </dt>

                        <dd class="col-sm-8">
                            @(Model.EmployeeName ?? "Not linked")
                        </dd>

                    </dl>

                </div>

            </div>

        </div>


        <!-- Roles -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-transparent">

                    <h5 class="mb-0">
                        Roles
                    </h5>

                </div>

                <div class="card-body">

                    @foreach (var role in Model.Roles)
                    {
                        <span class="badge text-bg-primary me-1 mb-1">
                            @role
                        </span>
                    }

                </div>

            </div>


            <!-- Reset Password -->

            <div class="card border-0 shadow-sm mt-4">

                <div class="card-header bg-transparent">

                    <h5 class="mb-0">
                        Reset Password
                    </h5>

                </div>

                <div class="card-body">

                    <form asp-action="ResetPassword"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <div class="mb-3">

                            <label class="form-label">
                                New Password
                            </label>

                            <input type="password"
                                   name="newPassword"
                                   class="form-control"
                                   minlength="8"
                                   required />

                        </div>

                        <button type="submit"
                                class="btn btn-warning w-100"
                                onclick="return confirm('Reset this user password?');">

                            <i class="bi bi-key me-1"></i>

                            Reset Password

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>