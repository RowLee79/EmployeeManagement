@using EmployeeManagement.Application.Payroll.Models
@model EmployeeManagement.Application.Payroll.Models.PayrollIndexViewModel

@{
    ViewData["Title"] = "Payroll Management";

    var totalPages =
        Model.Payrolls.PageSize > 0
            ? (int)Math.Ceiling(
                (double)Model.Payrolls.TotalCount /
                Model.Payrolls.PageSize)
            : 0;

    var hasPreviousPage =
        Model.Payrolls.PageNumber > 1;

    var hasNextPage =
        Model.Payrolls.PageNumber < totalPages;

    var firstItem =
        Model.Payrolls.TotalCount == 0
            ? 0
            : ((Model.Payrolls.PageNumber - 1)
                * Model.Payrolls.PageSize) + 1;

    var lastItem =
        Math.Min(
            Model.Payrolls.PageNumber *
            Model.Payrolls.PageSize,
            Model.Payrolls.TotalCount);
}

<div class="container-fluid">

    <!-- ========================================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center
                gap-3
                mb-4">

        <div>
            <h2 class="mb-1">
                <i class="bi bi-cash-stack me-2"></i>
                Payroll Management
            </h2>

            <p class="text-muted mb-0">
                Manage employee payroll records, calculations,
                approvals, and finalization.
            </p>
        </div>

        <div>
            <a asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-circle me-1"></i>
                Create Payroll

            </a>
        </div>

    </div>


    <!-- ========================================================= -->
    <!-- DASHBOARD -->
    <!-- ========================================================= -->

    <div class="row g-3 mb-4">

        <!-- Total Payrolls -->
        <div class="col-12 col-sm-6 col-xl-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                                justify-content-between
                                align-items-center">

                        <div>

                            <div class="text-muted small">
                                Total Payrolls
                            </div>

                            <h3 class="mb-0">
                                @Model.Dashboard.TotalPayrolls
                            </h3>

                        </div>

                        <div class="fs-1 text-primary">
                            <i class="bi bi-receipt"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Draft -->
        <div class="col-12 col-sm-6 col-xl-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                                justify-content-between
                                align-items-center">

                        <div>

                            <div class="text-muted small">
                                Draft
                            </div>

                            <h3 class="mb-0">
                                @Model.Dashboard.DraftCount
                            </h3>

                        </div>

                        <div class="fs-1 text-secondary">
                            <i class="bi bi-pencil-square"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Calculated -->
        <div class="col-12 col-sm-6 col-xl-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                                justify-content-between
                                align-items-center">

                        <div>

                            <div class="text-muted small">
                                Calculated
                            </div>

                            <h3 class="mb-0">
                                @Model.Dashboard.CalculatedCount
                            </h3>

                        </div>

                        <div class="fs-1 text-info">
                            <i class="bi bi-calculator"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Approved -->
        <div class="col-12 col-sm-6 col-xl-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                                justify-content-between
                                align-items-center">

                        <div>

                            <div class="text-muted small">
                                Approved
                            </div>

                            <h3 class="mb-0">
                                @Model.Dashboard.ApprovedCount
                            </h3>

                        </div>

                        <div class="fs-1 text-warning">
                            <i class="bi bi-check-circle"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Finalized -->
        <div class="col-12 col-sm-6 col-xl-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                                justify-content-between
                                align-items-center">

                        <div>

                            <div class="text-muted small">
                                Finalized
                            </div>

                            <h3 class="mb-0">
                                @Model.Dashboard.FinalizedCount
                            </h3>

                        </div>

                        <div class="fs-1 text-success">
                            <i class="bi bi-check2-all"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Cancelled -->
        <div class="col-12 col-sm-6 col-xl-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                                justify-content-between
                                align-items-center">

                        <div>

                            <div class="text-muted small">
                                Cancelled
                            </div>

                            <h3 class="mb-0">
                                @Model.Dashboard.CancelledCount
                            </h3>

                        </div>

                        <div class="fs-1 text-danger">
                            <i class="bi bi-x-circle"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- PAYROLL SUMMARY -->
    <!-- ========================================================= -->

    <div class="row g-3 mb-4">

        <!-- Gross -->
        <div class="col-12 col-md-4">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <div class="text-muted small">
                        Total Gross Salary
                    </div>

                    <h4 class="mb-0">
                        ₱@Model.Dashboard.TotalGrossSalary.ToString("N2")
                    </h4>

                </div>

            </div>

        </div>


        <!-- Deductions -->
        <div class="col-12 col-md-4">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <div class="text-muted small">
                        Total Deductions
                    </div>

                    <h4 class="mb-0">
                        ₱@Model.Dashboard.TotalDeductions.ToString("N2")
                    </h4>

                </div>

            </div>

        </div>


        <!-- Net -->
        <div class="col-12 col-md-4">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <div class="text-muted small">
                        Total Net Salary
                    </div>

                    <h4 class="mb-0">
                        ₱@Model.Dashboard.TotalNetSalary.ToString("N2")
                    </h4>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- SEARCH / FILTER -->
    <!-- ========================================================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                <i class="bi bi-funnel me-1"></i>
                Search & Filter
            </h5>

        </div>

        <div class="card-body">

            <form asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <!-- Search -->
                    <div class="col-12 col-lg-4">

                        <label class="form-label">
                            Search Employee
                        </label>

                        <input type="text"
                               name="Search"
                               value="@Model.Search"
                               class="form-control"
                               placeholder="Employee number or name..." />

                    </div>


                    <!-- Status -->
                    <div class="col-12 col-md-6 col-lg-2">

                        <label class="form-label">
                            Status
                        </label>

                        <select name="Status"
                                class="form-select">

                            <option value="">
                                All Statuses
                            </option>

                            <option value="Draft"
                                    selected="@(Model.Status == "Draft")">
                                Draft
                            </option>

                            <option value="Calculated"
                                    selected="@(Model.Status == "Calculated")">
                                Calculated
                            </option>

                            <option value="Approved"
                                    selected="@(Model.Status == "Approved")">
                                Approved
                            </option>

                            <option value="Finalized"
                                    selected="@(Model.Status == "Finalized")">
                                Finalized
                            </option>

                            <option value="Cancelled"
                                    selected="@(Model.Status == "Cancelled")">
                                Cancelled
                            </option>

                        </select>

                    </div>


                    <!-- Date From -->
                    <div class="col-12 col-md-6 col-lg-2">

                        <label class="form-label">
                            Payroll Date From
                        </label>

                        <input type="date"
                               name="PayrollDateFrom"
                               value="@(Model.PayrollDateFrom?.ToString("yyyy-MM-dd"))"
                               class="form-control" />

                    </div>


                    <!-- Date To -->
                    <div class="col-12 col-md-6 col-lg-2">

                        <label class="form-label">
                            Payroll Date To
                        </label>

                        <input type="date"
                               name="PayrollDateTo"
                               value="@(Model.PayrollDateTo?.ToString("yyyy-MM-dd"))"
                               class="form-control" />

                    </div>


                    <!-- Page Size -->
                    <div class="col-12 col-md-6 col-lg-2">

                        <label class="form-label">
                            Page Size
                        </label>

                        <select name="PageSize"
                                class="form-select">

                            <option value="10"
                                    selected="@(Model.PageSize == 10)">
                                10
                            </option>

                            <option value="25"
                                    selected="@(Model.PageSize == 25)">
                                25
                            </option>

                            <option value="50"
                                    selected="@(Model.PageSize == 50)">
                                50
                            </option>

                            <option value="100"
                                    selected="@(Model.PageSize == 100)">
                                100
                            </option>

                        </select>

                    </div>

                </div>


                <div class="d-flex
                            flex-wrap
                            gap-2
                            mt-3">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-search me-1"></i>
                        Search

                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                        Clear

                    </a>

                </div>

            </form>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- PAYROLL TABLE -->
    <!-- ========================================================= -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">

            <div class="d-flex
                        flex-column
                        flex-md-row
                        justify-content-between
                        align-items-md-center
                        gap-2">

                <h5 class="mb-0">

                    <i class="bi bi-table me-1"></i>
                    Payroll Records

                </h5>

                @if (Model.Payrolls.TotalCount > 0)
                {
                    <span class="text-muted small">

                        @Model.Payrolls.TotalCount
                        record(s)

                    </span>
                }

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Payrolls.Items != null &&
                 Model.Payrolls.Items.Any())
            {
                <div class="table-responsive">

                    <table class="table
                                  table-hover
                                  align-middle
                                  mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Employee
                                </th>

                                <th>
                                    Payroll Date
                                </th>

                                <th class="text-end">
                                    Basic Salary
                                </th>

                                <th class="text-end">
                                    Overtime
                                </th>

                                <th class="text-end">
                                    Allowances
                                </th>

                                <th class="text-end">
                                    Gross
                                </th>

                                <th class="text-end">
                                    Deductions
                                </th>

                                <th class="text-end">
                                    Net Salary
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var payroll
                                in Model.Payrolls.Items)
                            {
                                <tr>

                                    <!-- Employee -->
                                    <td>

                                        <div class="fw-semibold">
                                            @payroll.EmployeeName
                                        </div>

                                        <div class="text-muted small">
                                            @payroll.EmployeeNumber
                                        </div>

                                    </td>


                                    <!-- Payroll Date -->
                                    <td>
                                        @payroll.PayrollDate.ToString("dd-MMM-yyyy")
                                    </td>


                                    <!-- Basic Salary -->
                                    <td class="text-end">
                                        ₱@payroll.BasicSalary.ToString("N2")
                                    </td>


                                    <!-- Overtime -->
                                    <td class="text-end">
                                        ₱@payroll.Overtime.ToString("N2")
                                    </td>


                                    <!-- Allowances -->
                                    <td class="text-end">
                                        ₱@payroll.Allowances.ToString("N2")
                                    </td>


                                    <!-- Gross -->
                                    <td class="text-end fw-semibold">
                                        ₱@payroll.GrossSalary.ToString("N2")
                                    </td>


                                    <!-- Deductions -->
                                    <td class="text-end">
                                        ₱@payroll.Deductions.ToString("N2")
                                    </td>


                                    <!-- Net -->
                                    <td class="text-end fw-semibold">
                                        ₱@payroll.NetSalary.ToString("N2")
                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @switch (payroll.Status)
                                        {
                                            case "Draft":

                                                <span class="badge bg-secondary">
                                                    Draft
                                                </span>

                                                break;

                                            case "Calculated":

                                                <span class="badge bg-info text-dark">
                                                    Calculated
                                                </span>

                                                break;

                                            case "Approved":

                                                <span class="badge bg-warning text-dark">
                                                    Approved
                                                </span>

                                                break;

                                            case "Finalized":

                                                <span class="badge bg-success">
                                                    Finalized
                                                </span>

                                                break;

                                            case "Cancelled":

                                                <span class="badge bg-danger">
                                                    Cancelled
                                                </span>

                                                break;

                                            default:

                                                <span class="badge bg-secondary">
                                                    @payroll.Status
                                                </span>

                                                break;
                                        }

                                    </td>


                                    <!-- Actions -->
                                    <td>

                                        <div class="d-flex
                                                    justify-content-end
                                                    gap-1">

                                            <!-- Details -->
                                            <a asp-action="Details"
                                               asp-route-id="@payroll.Id"
                                               class="btn btn-sm
                                                      btn-outline-primary"
                                               title="View Details">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                               <!-- Payslip -->
                                            <a asp-action="Payslip"
                                               asp-route-id="@payroll.Id"
                                               class="btn btn-sm btn-outline-success"
                                               title="View Payslip">

                                                <i class="bi bi-file-earmark-text"></i>

                                            </a>

                                            <!-- Edit -->
                                            @if (payroll.Status == "Draft")
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@payroll.Id"
                                                   class="btn btn-sm
                                                          btn-outline-warning"
                                                   title="Edit Payroll">

                                                    <i class="bi bi-pencil"></i>

                                                </a>
                                            }


                                            <!-- Employee History -->
                                            <a asp-action="EmployeeHistory"
                                               asp-route-employeeId="@payroll.EmployeeId"
                                               class="btn btn-sm
                                                      btn-outline-info"
                                               title="Payroll History">

                                                <i class="bi bi-clock-history"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Empty State -->

                <div class="text-center
                            py-5">

                    <div class="mb-3">

                        <i class="bi bi-receipt
                                  display-4
                                  text-muted"></i>

                    </div>

                    <h5>
                        No payroll records found
                    </h5>

                    <p class="text-muted mb-3">
                        There are no payroll records matching
                        your search criteria.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-circle me-1"></i>
                        Create Payroll

                    </a>

                </div>
            }

        </div>


        <!-- ===================================================== -->
        <!-- PAGINATION FOOTER -->
        <!-- ===================================================== -->

        @if (Model.Payrolls.TotalCount > 0)
        {
            <div class="card-footer bg-white">

                <div class="d-flex
                            flex-column
                            flex-md-row
                            justify-content-between
                            align-items-center
                            gap-3">

                    <!-- Record Information -->

                    <div class="text-muted small">

                        Showing

                        <strong>
                            @firstItem
                        </strong>

                        to

                        <strong>
                            @lastItem
                        </strong>

                        of

                        <strong>
                            @Model.Payrolls.TotalCount
                        </strong>

                        payroll records

                    </div>


                    <!-- Pagination -->

                    @if (totalPages > 1)
                    {
                        <nav aria-label="Payroll pagination">

                            <ul class="pagination
                                       pagination-sm
                                       mb-0">


                                <!-- Previous -->

                                <li class="page-item
                                           @(hasPreviousPage
                                               ? ""
                                               : "disabled")">

                                    @if (hasPreviousPage)
                                    {
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-Search="@Model.Search"
                                           asp-route-Status="@Model.Status"
                                           asp-route-PayrollDateFrom="@Model.PayrollDateFrom"
                                           asp-route-PayrollDateTo="@Model.PayrollDateTo"
                                           asp-route-PageNumber="@(Model.Payrolls.PageNumber - 1)"
                                           asp-route-PageSize="@Model.Payrolls.PageSize"
                                           asp-route-SortBy="@Model.SortBy"
                                           asp-route-SortDescending="@Model.SortDescending">

                                            <i class="bi bi-chevron-left"></i>
                                            Previous

                                        </a>
                                    }
                                    else
                                    {
                                        <span class="page-link">

                                            <i class="bi bi-chevron-left"></i>
                                            Previous

                                        </span>
                                    }

                                </li>


                                <!-- Page Numbers -->

                                @for (var page = 1;
                                      page <= totalPages;
                                      page++)
                                {
                                    <li class="page-item
                                               @(page ==
                                                 Model.Payrolls.PageNumber
                                                     ? "active"
                                                     : "")">

                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-Search="@Model.Search"
                                           asp-route-Status="@Model.Status"
                                           asp-route-PayrollDateFrom="@Model.PayrollDateFrom"
                                           asp-route-PayrollDateTo="@Model.PayrollDateTo"
                                           asp-route-PageNumber="@(page)"
                                           asp-route-PageSize="@Model.Payrolls.PageSize"
                                           asp-route-SortBy="@Model.SortBy"
                                           asp-route-SortDescending="@Model.SortDescending">

                                            @(page)
                                        </a>

                                    </li>
                                }


                                <!-- Next -->

                                <li class="page-item
                                           @(hasNextPage
                                               ? ""
                                               : "disabled")">

                                    @if (hasNextPage)
                                    {
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-Search="@Model.Search"
                                           asp-route-Status="@Model.Status"
                                           asp-route-PayrollDateFrom="@Model.PayrollDateFrom"
                                           asp-route-PayrollDateTo="@Model.PayrollDateTo"
                                           asp-route-PageNumber="@(Model.Payrolls.PageNumber + 1)"
                                           asp-route-PageSize="@Model.Payrolls.PageSize"
                                           asp-route-SortBy="@Model.SortBy"
                                           asp-route-SortDescending="@Model.SortDescending">

                                            Next
                                            <i class="bi bi-chevron-right"></i>

                                        </a>
                                    }
                                    else
                                    {
                                        <span class="page-link">

                                            Next
                                            <i class="bi bi-chevron-right"></i>

                                        </span>
                                    }

                                </li>

                            </ul>

                        </nav>
                    }

                </div>

            </div>
        }

    </div>

</div>