@using EmployeeManagement.Application.Payroll.Models

@model IReadOnlyList<PayrollListModel>

@{
    ViewData["Title"] = "Payroll";

    var dashboard =
        ViewBag.Dashboard as PayrollDashboardModel
        ?? new PayrollDashboardModel();
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 mb-1">Payroll</h1>

            <p class="text-muted mb-0">
                Manage employee payroll records.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-lg"></i>
            Create Payroll

        </a>

    </div>


    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                Payroll Records
            </h5>

        </div>

        <!-- ===================================================== -->
        <!-- DASHBOARD -->
        <!-- ===================================================== -->

        <div class="row g-3 mb-4">

            <!-- Total Payroll -->
            <div class="col-xl-2 col-md-4 col-sm-6">

                <div class="card shadow-sm h-100">

                    <div class="card-body">

                        <div class="text-muted small">
                            Total Payroll
                        </div>

                        <div class="fs-3 fw-bold">
                            @dashboard.TotalPayrolls
                        </div>

                    </div>

                </div>

            </div>


            <!-- Draft -->
            <div class="col-xl-2 col-md-4 col-sm-6">

                <div class="card shadow-sm h-100">

                    <div class="card-body">

                        <div class="text-muted small">
                            Draft
                        </div>

                        <div class="fs-3 fw-bold">
                            @dashboard.DraftCount
                        </div>

                    </div>

                </div>

            </div>


            <!-- Calculated -->
            <div class="col-xl-2 col-md-4 col-sm-6">

                <div class="card shadow-sm h-100">

                    <div class="card-body">

                        <div class="text-muted small">
                            Calculated
                        </div>

                        <div class="fs-3 fw-bold">
                            @dashboard.CalculatedCount
                        </div>

                    </div>

                </div>

            </div>


            <!-- Approved -->
            <div class="col-xl-2 col-md-4 col-sm-6">

                <div class="card shadow-sm h-100">

                    <div class="card-body">

                        <div class="text-muted small">
                            Approved
                        </div>

                        <div class="fs-3 fw-bold">
                            @dashboard.ApprovedCount
                        </div>

                    </div>

                </div>

            </div>


            <!-- Finalized -->
            <div class="col-xl-2 col-md-4 col-sm-6">

                <div class="card shadow-sm h-100">

                    <div class="card-body">

                        <div class="text-muted small">
                            Finalized
                        </div>

                        <div class="fs-3 fw-bold">
                            @dashboard.FinalizedCount
                        </div>

                    </div>

                </div>

            </div>


            <!-- Cancelled -->
            <div class="col-xl-2 col-md-4 col-sm-6">

                <div class="card shadow-sm h-100">

                    <div class="card-body">

                        <div class="text-muted small">
                            Cancelled
                        </div>

                        <div class="fs-3 fw-bold">
                            @dashboard.CancelledCount
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- SALARY SUMMARY -->
        <!-- ===================================================== -->

        <div class="row g-3 mb-4">

            <div class="col-md-4">

                <div class="card shadow-sm">

                    <div class="card-body">

                        <div class="text-muted">
                            Total Gross Salary
                        </div>

                        <div class="fs-4 fw-bold">
                            ₱@dashboard.TotalGrossSalary.ToString("N2")
                        </div>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card shadow-sm">

                    <div class="card-body">

                        <div class="text-muted">
                            Total Deductions
                        </div>

                        <div class="fs-4 fw-bold">
                            ₱@dashboard.TotalDeductions.ToString("N2")
                        </div>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card shadow-sm">

                    <div class="card-body">

                        <div class="text-muted">
                            Total Net Salary
                        </div>

                        <div class="fs-4 fw-bold">
                            ₱@dashboard.TotalNetSalary.ToString("N2")
                        </div>

                    </div>

                </div>

            </div>

        </div>
        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Employee</th>

                            <th>Payroll Date</th>

                            <th class="text-end">
                                Basic Salary
                            </th>

                            <th class="text-end">
                                Overtime
                            </th>

                            <th class="text-end">
                                Allowances
                            </th>

                            <th class="text-end">
                                Gross
                            </th>

                            <th class="text-end">
                                Deductions
                            </th>

                            <th class="text-end">
                                Net Salary
                            </th>

                            <th>Status</th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Count == 0)
                        {
                            <tr>

                                <td colspan="10"
                                    class="text-center py-5 text-muted">

                                    No payroll records found.

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var payroll in Model)
                            {
                                <tr>

                                    <td>

                                        <div class="fw-semibold">
                                            @payroll.EmployeeName
                                        </div>

                                        <small class="text-muted">
                                            @payroll.EmployeeNumber
                                        </small>

                                    </td>

                                    <td>
                                        @payroll.PayrollDate.ToString("dd-MMM-yyyy")
                                    </td>

                                    <td class="text-end">
                                        @payroll.BasicSalary.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        @payroll.Overtime.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        @payroll.Allowances.ToString("N2")
                                    </td>

                                    <td class="text-end fw-semibold">
                                        @payroll.GrossSalary.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        @payroll.Deductions.ToString("N2")
                                    </td>

                                    <td class="text-end fw-bold">
                                        @payroll.NetSalary.ToString("N2")
                                    </td>

                                    <td>

                                        @switch (payroll.Status)
                                        {
                                            case "Draft":
                                                <span class="badge bg-secondary">
                                                    Draft
                                                </span>
                                                break;

                                            case "Calculated":
                                                <span class="badge bg-info">
                                                    Calculated
                                                </span>
                                                break;

                                            case "Approved":
                                                <span class="badge bg-success">
                                                    Approved
                                                </span>
                                                break;

                                            case "Finalized":
                                                <span class="badge bg-primary">
                                                    Finalized
                                                </span>
                                                break;

                                            case "Cancelled":
                                                <span class="badge bg-danger">
                                                    Cancelled
                                                </span>
                                                break;

                                            default:
                                                <span class="badge bg-secondary">
                                                    @payroll.Status
                                                </span>
                                                break;
                                        }

                                    </td>

                                    <td class="text-end">

                                        <div class="btn-group">

                                            <a asp-action="Details"
                                               asp-route-id="@payroll.Id"
                                               class="btn btn-sm btn-outline-primary">

                                                <i class="bi bi-eye"></i>

                                            </a>

                                            @if (payroll.Status == "Draft")
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@payroll.Id"
                                                   class="btn btn-sm btn-outline-secondary">

                                                    <i class="bi bi-pencil"></i>

                                                </a>

                                                <form asp-action="Delete"
                                                      asp-route-id="@payroll.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Delete this payroll record?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger">

                                                        <i class="bi bi-trash"></i>

                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>