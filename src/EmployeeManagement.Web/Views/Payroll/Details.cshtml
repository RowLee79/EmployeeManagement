@model EmployeeManagement.Application.Payroll.Models.PayrollDetailsModel

@{
    ViewData["Title"] = "Payroll Details";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="h3 mb-1">
                Payroll Details
            </h1>

            <p class="text-muted mb-0">
                @Model.EmployeeNumber -
                @Model.EmployeeName
            </p>

        </div>

        <div>

         <div class="d-flex gap-2">

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left"></i>
        Back

    </a>


    @if (Model.Status == "Draft")
    {
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-outline-primary">

            <i class="bi bi-pencil"></i>
            Edit

        </a>

        <form asp-action="Calculate"
              asp-route-id="@Model.Id"
              method="post"
              class="d-inline">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-calculator"></i>
                Calculate

            </button>

        </form>
    }


    @if (Model.Status == "Calculated")
    {
        <form asp-action="Approve"
              asp-route-id="@Model.Id"
              method="post"
              class="d-inline">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-success">

                <i class="bi bi-check-circle"></i>
                Approve

            </button>

        </form>
    }


    @if (Model.Status == "Approved")
    {
        <form asp-action="Finalize"
              asp-route-id="@Model.Id"
              method="post"
              class="d-inline">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-lock"></i>
                Finalize

            </button>

        </form>
    }


    @if (Model.Status != "Finalized" &&
         Model.Status != "Cancelled")
    {
        <form asp-action="Cancel"
              asp-route-id="@Model.Id"
              method="post"
              class="d-inline"
              onsubmit="return confirm('Cancel this payroll?');">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-outline-danger">

                <i class="bi bi-x-circle"></i>
                Cancel

            </button>

        </form>
    }

</div>

            @if (Model.Status == "Draft")
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">

                    <i class="bi bi-pencil"></i>
                    Edit

                </a>
            }

        </div>

    </div>


    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Salary Information
                    </h5>

                </div>

                <div class="card-body">

                    <div class="row g-4">

                        <div class="col-md-6">

                            <small class="text-muted">
                                Basic Salary
                            </small>

                            <div class="fs-5 fw-semibold">
                                ₱@Model.BasicSalary.ToString("N2")
                            </div>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted">
                                Overtime
                            </small>

                            <div class="fs-5">
                                ₱@Model.Overtime.ToString("N2")
                            </div>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted">
                                Allowances
                            </small>

                            <div class="fs-5">
                                ₱@Model.Allowances.ToString("N2")
                            </div>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted">
                                Deductions
                            </small>

                            <div class="fs-5 text-danger">
                                ₱@Model.Deductions.ToString("N2")
                            </div>

                        </div>

                    </div>

                    <hr />

                    <div class="row">

                        <div class="col-md-6">

                            <span class="text-muted">
                                Gross Salary
                            </span>

                            <div class="fs-4 fw-bold">
                                ₱@Model.GrossSalary.ToString("N2")
                            </div>

                        </div>

                        <div class="col-md-6">

                            <span class="text-muted">
                                Net Salary
                            </span>

                            <div class="fs-4 fw-bold text-success">
                                ₱@Model.NetSalary.ToString("N2")
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-lg-4">

            <div class="card shadow-sm">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Payroll Information
                    </h5>

                </div>

                <div class="card-body">

                    <dl class="row mb-0">

                        <dt class="col-sm-5">
                            Employee
                        </dt>

                        <dd class="col-sm-7">
                            @Model.EmployeeNumber
                        </dd>


                        <dt class="col-sm-5">
                            Date
                        </dt>

                        <dd class="col-sm-7">
                            @Model.PayrollDate.ToString("dd-MMM-yyyy")
                        </dd>


                        <dt class="col-sm-5">
                            Status
                        </dt>

                        <dd class="col-sm-7">

                            <span class="badge bg-secondary">
                                @Model.Status
                            </span>

                        </dd>


                        <dt class="col-sm-5">
                            Created
                        </dt>

                        <dd class="col-sm-7">
                            @Model.CreatedDate.ToString("dd-MMM-yyyy HH:mm")
                        </dd>

                    </dl>

                </div>

            </div>

        </div>

    </div>

</div>