@model EmployeeManagement.Application.Positions.Models.PositionCreateModel

<div class="page-header">
    <div>
        <h1>Create Position</h1>
        <p>Add a new job position.</p>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">

        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="row g-3">

                <!-- Position Code -->
                <div class="col-md-4">

                    <label asp-for="Code"
                           class="form-label">
                        Position Code
                    </label>

                    <input asp-for="Code"
                           class="form-control"
                           placeholder="e.g. DEV" />

                    <span asp-validation-for="Code"
                          class="text-danger">
                    </span>

                </div>


                <!-- Position Name -->
                <div class="col-md-8">

                    <label asp-for="Name"
                           class="form-label">
                        Position Name
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="e.g. Software Developer" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>


                <!-- Department -->
                <div class="col-md-6">

                    <label asp-for="DepartmentId"
                           class="form-label">
                        Department
                    </label>

                    <select asp-for="DepartmentId"
                            class="form-select">

                        <option value="">
                            Select department
                        </option>

                        @foreach (var department in Model.Departments)
                        {
                            <option value="@department.Id">
                                @department.Name
                            </option>
                        }

                    </select>

                    <span asp-validation-for="DepartmentId"
                          class="text-danger">
                    </span>

                </div>


                <!-- Minimum Salary -->
                <div class="col-md-3">

                    <label asp-for="MinimumSalary"
                           class="form-label">
                        Minimum Salary
                    </label>

                    <input asp-for="MinimumSalary"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0" />

                    <span asp-validation-for="MinimumSalary"
                          class="text-danger">
                    </span>

                </div>


                <!-- Maximum Salary -->
                <div class="col-md-3">

                    <label asp-for="MaximumSalary"
                           class="form-label">
                        Maximum Salary
                    </label>

                    <input asp-for="MaximumSalary"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0" />

                    <span asp-validation-for="MaximumSalary"
                          class="text-danger">
                    </span>

                </div>


                <!-- Description -->
                <div class="col-12">

                    <label asp-for="Description"
                           class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Enter position description...">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>


                <!-- Active -->
                <div class="col-12">

                    <div class="form-check">

                        <input asp-for="IsActive"
                               class="form-check-input" />

                        <label asp-for="IsActive"
                               class="form-check-label">
                            Active
                        </label>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <!-- Buttons -->
            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-lg"></i>

                    Save Position

                </button>

                <a asp-action="Index"
                   class="btn btn-light">

                    Cancel

                </a>

            </div>

        </form>

    </div>
</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}