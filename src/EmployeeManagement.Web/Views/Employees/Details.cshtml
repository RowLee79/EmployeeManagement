@using EmployeeManagement.Domain.Enums
@using EmployeeManagement.Application.Positions.Interfaces
@model EmployeeManagement.Application.Employees.Models.EmployeeDetailsModel

@{
    ViewData["Title"] = "Employee Details";

    var statusClass = Model.Status switch
    {
        EmployeeStatus.Active => "bg-success",
        EmployeeStatus.Inactive => "bg-secondary",
        EmployeeStatus.OnLeave => "bg-warning text-dark",
        EmployeeStatus.Resigned => "bg-info text-dark",
        EmployeeStatus.Terminated => "bg-danger",
        _ => "bg-secondary"
    };

    var profileInitials =
        $"{Model.FirstName.FirstOrDefault()}{Model.LastName.FirstOrDefault()}"
            .ToUpperInvariant();
}

<div class="container-fluid py-4">

    <!-- ========================================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Index"
                   class="text-decoration-none text-muted">
                    <i class="bi bi-people me-1"></i>
                    Employees
                </a>

                <i class="bi bi-chevron-right text-muted"></i>

                <span class="text-muted">
                    Details
                </span>
            </div>

            <h1 class="h3 mb-1">
                Employee Details
            </h1>

            <p class="text-muted mb-0">
                View employee information and employment details.
            </p>
        </div>

        <div class="d-flex gap-2 mt-3 mt-md-0">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>
                Edit Employee
            </a>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- EMPLOYEE PROFILE -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="row align-items-center">

                <!-- Profile -->
                <div class="col-md-8">

                    <div class="d-flex align-items-center">

                        @if (!string.IsNullOrWhiteSpace(Model.ProfileImage))
                        {
                            <img src="@Model.ProfileImage"
                                 alt="@Model.FirstName @Model.LastName"
                                 class="rounded-circle me-3"
                                 style="width: 90px; height: 90px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3"
                                 style="width: 90px; height: 90px; font-size: 28px; font-weight: 600;">
                                @profileInitials
                            </div>
                        }

                        <div>

                            <h2 class="h4 mb-1">
                                @Model.FirstName
                                @if (!string.IsNullOrWhiteSpace(Model.MiddleName))
                                {
                                    <span>@Model.MiddleName</span>
                                }
                                @Model.LastName
                                @if (!string.IsNullOrWhiteSpace(Model.Suffix))
                                {
                                    <span>@Model.Suffix</span>
                                }
                            </h2>

                            <div class="text-muted mb-2">
                                @Model.EmployeeNumber
                            </div>

                            <div class="d-flex flex-wrap gap-2">

                                <span class="badge @statusClass">
                                    @Model.Status
                                </span>

                                <span class="badge bg-light text-dark border">
                                    @Model.EmploymentType
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Salary -->
                <div class="col-md-4 mt-4 mt-md-0 text-md-end">

                    <div class="text-muted small">
                        Basic Salary
                    </div>

                    <div class="fs-3 fw-semibold">
                        ₱@Model.BasicSalary.ToString("N2")
                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="row g-4">

        <!-- ===================================================== -->
        <!-- PERSONAL INFORMATION -->
        <!-- ===================================================== -->

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="mb-1">
                        <i class="bi bi-person me-2 text-primary"></i>
                        Personal Information
                    </h5>

                    <p class="text-muted small mb-0">
                        Employee personal information.
                    </p>

                </div>

                <div class="card-body px-4">

                    <div class="row g-3">

                        <!-- First Name -->
                        <div class="col-md-6">

                            <label class="form-label text-muted small">
                                First Name
                            </label>

                            <div class="fw-semibold">
                                @Model.FirstName
                            </div>

                        </div>

                        <!-- Middle Name -->
                        <div class="col-md-6">

                            <label class="form-label text-muted small">
                                Middle Name
                            </label>

                            <div class="fw-semibold">
                                @(string.IsNullOrWhiteSpace(Model.MiddleName)
                                    ? "N/A"
                                    : Model.MiddleName)
                            </div>

                        </div>

                        <!-- Last Name -->
                        <div class="col-md-6">

                            <label class="form-label text-muted small">
                                Last Name
                            </label>

                            <div class="fw-semibold">
                                @Model.LastName
                            </div>

                        </div>

                        <!-- Suffix -->
                        <div class="col-md-6">

                            <label class="form-label text-muted small">
                                Suffix
                            </label>

                            <div class="fw-semibold">
                                @(string.IsNullOrWhiteSpace(Model.Suffix)
                                    ? "N/A"
                                    : Model.Suffix)
                            </div>

                        </div>

                        <!-- Birth Date -->
                        <div class="col-md-6">

                            <label class="form-label text-muted small">
                                Birth Date
                            </label>

                            <div class="fw-semibold">
                                @Model.BirthDate.ToString("MMM dd, yyyy")
                            </div>

                        </div>

                        <!-- Gender -->
                        <div class="col-md-6">

                            <label class="form-label text-muted small">
                                Gender
                            </label>

                            <div class="fw-semibold">
                                @Model.Gender
                            </div>

                        </div>

                        <!-- Civil Status -->
                        <div class="col-md-6">

                            <label class="form-label text-muted small">
                                Civil Status
                            </label>

                            <div class="fw-semibold">
                                @(string.IsNullOrWhiteSpace(Model.CivilStatus)
                                    ? "N/A"
                                    : Model.CivilStatus)
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- CONTACT INFORMATION -->
        <!-- ===================================================== -->

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="mb-1">
                        <i class="bi bi-telephone me-2 text-primary"></i>
                        Contact Information
                    </h5>

                    <p class="text-muted small mb-0">
                        Employee contact details.
                    </p>

                </div>

                <div class="card-body px-4">

                    <div class="row g-3">

                        <!-- Email -->
                        <div class="col-12">

                            <label class="form-label text-muted small">
                                Email Address
                            </label>

                            @if (!string.IsNullOrWhiteSpace(Model.Email))
                            {
                                <div>
                                    <a href="mailto:@Model.Email"
                                       class="text-decoration-none">
                                        <i class="bi bi-envelope me-1"></i>
                                        @Model.Email
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="fw-semibold">
                                    N/A
                                </div>
                            }

                        </div>

                        <!-- Phone -->
                        <div class="col-md-6">

                            <label class="form-label text-muted small">
                                Phone Number
                            </label>

                            @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                            {
                                <div>
                                    <a href="tel:@Model.PhoneNumber"
                                       class="text-decoration-none">
                                        <i class="bi bi-telephone me-1"></i>
                                        @Model.PhoneNumber
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="fw-semibold">
                                    N/A
                                </div>
                            }

                        </div>

                        <!-- Address -->
                        <div class="col-12">

                            <label class="form-label text-muted small">
                                Address
                            </label>

                            <div class="fw-semibold">
                                @(string.IsNullOrWhiteSpace(Model.Address)
                                    ? "N/A"
                                    : Model.Address)
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- EMPLOYMENT INFORMATION -->
        <!-- ===================================================== -->

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="mb-1">
                        <i class="bi bi-briefcase me-2 text-primary"></i>
                        Employment Information
                    </h5>

                    <p class="text-muted small mb-0">
                        Employee position and employment details.
                    </p>

                </div>

                <div class="card-body px-4">

                    <div class="row g-3">

                        <!-- Employee Number -->
                        <div class="col-md-6">

                            <label class="form-label text-muted small">
                                Employee Number
                            </label>

                            <div class="fw-semibold">
                                @Model.EmployeeNumber
                            </div>

                        </div>

                        <!-- Employment Type -->
                        <div class="col-md-6">

                            <label class="form-label text-muted small">
                                Employment Type
                            </label>

                            <div class="fw-semibold">
                                @Model.EmploymentType
                            </div>

                        </div>

                        <!-- Department -->
                        <div class="col-md-6">

                            <label class="form-label text-muted small">
                                Department
                            </label>

                            <div class="fw-semibold">
                                @Model.DepartmentName
                            </div>

                        </div>

                        <!-- Position -->
                        <div class="col-md-6">

                            <label class="form-label text-muted small">
                                Position
                            </label>

                            <div class="fw-semibold">
                                @Model.PositionName
                            </div>

                        </div>

                        <!-- Hire Date -->
                        <div class="col-md-6">

                            <label class="form-label text-muted small">
                                Hire Date
                            </label>

                            <div class="fw-semibold">
                                @Model.HireDate.ToString("MMM dd, yyyy")
                            </div>

                        </div>

                        <!-- Regularization -->
                        <div class="col-md-6">

                            <label class="form-label text-muted small">
                                Regularization Date
                            </label>

                            <div class="fw-semibold">
                                @(Model.RegularizationDate.HasValue
                                    ? Model.RegularizationDate.Value.ToString("MMM dd, yyyy")
                                    : "N/A")
                            </div>

                        </div>

                        <!-- Status -->
                        <div class="col-md-6">

                            <label class="form-label text-muted small">
                                Status
                            </label>

                            <div>
                                <span class="badge @statusClass">
                                    @Model.Status
                                </span>
                            </div>

                        </div>

                        <!-- Salary -->
                        <div class="col-md-6">

                            <label class="form-label text-muted small">
                                Basic Salary
                            </label>

                            <div class="fw-semibold">
                                ₱@Model.BasicSalary.ToString("N2")
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- AUDIT INFORMATION -->
        <!-- ===================================================== -->

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="mb-1">
                        <i class="bi bi-clock-history me-2 text-primary"></i>
                        Record Information
                    </h5>

                    <p class="text-muted small mb-0">
                        Record creation and modification information.
                    </p>

                </div>

                <div class="card-body px-4">

                    <div class="row g-3">

                        <!-- Created Date -->
                        <div class="col-md-6">

                            <label class="form-label text-muted small">
                                Created Date
                            </label>

                            <div class="fw-semibold">
                                @Model.CreatedDate.ToString("MMM dd, yyyy hh:mm tt")
                            </div>

                        </div>

                        <!-- Created By -->
                        <div class="col-md-6">

                            <label class="form-label text-muted small">
                                Created By
                            </label>

                            <div class="fw-semibold">
                                @(string.IsNullOrWhiteSpace(Model.CreatedBy)
                                    ? "N/A"
                                    : Model.CreatedBy)
                            </div>

                        </div>

                        <!-- Updated Date -->
                        <div class="col-md-6">

                            <label class="form-label text-muted small">
                                Updated Date
                            </label>

                            <div class="fw-semibold">
                                @(Model.UpdatedDate.HasValue
                                    ? Model.UpdatedDate.Value.ToString("MMM dd, yyyy hh:mm tt")
                                    : "N/A")
                            </div>

                        </div>

                        <!-- Updated By -->
                        <div class="col-md-6">

                            <label class="form-label text-muted small">
                                Updated By
                            </label>

                            <div class="fw-semibold">
                                @(string.IsNullOrWhiteSpace(Model.UpdatedBy)
                                    ? "N/A"
                                    : Model.UpdatedBy)
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- ACTIONS -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm mt-4">

        <div class="card-body d-flex flex-column flex-md-row justify-content-between gap-2">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Employees
            </a>

            <div class="d-flex gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    <i class="bi bi-pencil me-1"></i>
                    Edit Employee
                </a>

                <form asp-action="Delete"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="d-inline"
                      onsubmit="return confirm('Are you sure you want to delete this employee?');">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-outline-danger">
                        <i class="bi bi-trash me-1"></i>
                        Delete
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>