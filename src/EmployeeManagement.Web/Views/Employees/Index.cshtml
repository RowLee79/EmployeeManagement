@using EmployeeManagement.Application.Common.Models
@using EmployeeManagement.Application.Departments.Models
@using EmployeeManagement.Application.Employees.Models
@using EmployeeManagement.Application.Positions.Models
@using EmployeeManagement.Domain.Enums

@model PagedResult<EmployeeListModel>

@{
    ViewData["Title"] = "Employees";

    var departments =
        ViewBag.Departments as IReadOnlyList<DepartmentLookup>
        ?? Array.Empty<DepartmentLookup>();

    var positions =
        ViewBag.Positions as IReadOnlyList<PositionLookup>
        ?? Array.Empty<PositionLookup>();

    var search =
        ViewBag.Search as string;

    int? departmentId =
        ViewBag.DepartmentId;

    int? positionId =
        ViewBag.PositionId;

    int? status =
        ViewBag.Status;

    int? employmentType =
        ViewBag.EmploymentType;

    DateTime? hireDateFrom =
        ViewBag.HireDateFrom;

    DateTime? hireDateTo =
        ViewBag.HireDateTo;

    var sortBy =
        ViewBag.SortBy as string ?? "HireDate";

    var sortDescending =
        ViewBag.SortDescending is bool value && value;
}


<div class="container-fluid">


    <!-- ============================================================
         PAGE HEADER
    ============================================================= -->

    <div class="d-flex flex-wrap
                justify-content-between
                align-items-center
                mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Employees
            </h2>

            <p class="text-muted mb-0">
                Manage employee records and information.
            </p>

        </div>


        <div class="mt-3 mt-md-0">

            <a asp-controller="Employees"
               asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-lg me-1"></i>

                Add Employee

            </a>

        </div>

    </div>


    <!-- ============================================================
         SEARCH AND FILTER CARD
    ============================================================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex align-items-center">

                <i class="bi bi-funnel me-2"></i>

                <h5 class="mb-0 fw-semibold">
                    Search & Filters
                </h5>

            </div>

        </div>


        <div class="card-body">

            <form id="employeeSearchForm"
                  asp-controller="Employees"
                  asp-action="Index"
                  method="get">


                <!-- ====================================================
                     HIDDEN SEARCH STATE
                ===================================================== -->

                <input type="hidden"
                       name="SortBy"
                       value="@sortBy" />

                <input type="hidden"
                       name="SortDescending"
                       value="@sortDescending" />

                <input type="hidden"
                       name="PageNumber"
                       value="1" />


                <div class="row g-3">


                    <!-- =================================================
                         SEARCH
                    ================================================== -->

                    <div class="col-md-6 col-lg-3">

                        <label for="Search"
                               class="form-label fw-semibold">

                            Search

                        </label>


                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-search"></i>

                            </span>


                            <input type="text"
                                   id="Search"
                                   name="Search"
                                   value="@search"
                                   class="form-control"
                                   placeholder="Employee number, name, email..." />

                        </div>

                    </div>


                    <!-- =================================================
                         DEPARTMENT
                    ================================================== -->

                    <div class="col-md-6 col-lg-2">

                        <label for="DepartmentId"
                               class="form-label fw-semibold">

                            Department

                        </label>


                        <select name="DepartmentId"
                                id="DepartmentId"
                                class="form-select">

                            <option value="">
                                All Departments
                            </option>


                            @foreach (var department in departments)
                            {
                                if (departmentId == department.Id)
                                {
                                    <option value="@department.Id"
                                            selected>

                                        @department.Name

                                    </option>
                                }
                                else
                                {
                                    <option value="@department.Id">

                                        @department.Name

                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- =================================================
                         POSITION
                    ================================================== -->

                    <div class="col-md-6 col-lg-2">

                        <label for="PositionId"
                               class="form-label fw-semibold">

                            Position

                        </label>


                        <select name="PositionId"
                                id="PositionId"
                                class="form-select">

                            <option value="">
                                All Positions
                            </option>


                            @foreach (var position in positions)
                            {
                                if (positionId == position.Id)
                                {
                                    <option value="@position.Id"
                                            data-department-id="@position.DepartmentId"
                                            selected>

                                        @position.Name

                                    </option>
                                }
                                else
                                {
                                    <option value="@position.Id"
                                            data-department-id="@position.DepartmentId">

                                        @position.Name

                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- =================================================
                         EMPLOYMENT TYPE
                    ================================================== -->

                    <div class="col-md-6 col-lg-2">

                        <label for="EmploymentType"
                               class="form-label fw-semibold">

                            Employment Type

                        </label>


                        <select name="EmploymentType"
                                id="EmploymentType"
                                class="form-select">

                            <option value="">
                                All Types
                            </option>


                            @foreach (
                                var type
                                in Enum.GetValues<EmploymentType>())
                            {
                                if (employmentType == (int)type)
                                {
                                    <option value="@((int)type)"
                                            selected>

                                        @type

                                    </option>
                                }
                                else
                                {
                                    <option value="@((int)type)">

                                        @type

                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- =================================================
                         STATUS
                    ================================================== -->

                    <div class="col-md-6 col-lg-2">

                        <label for="Status"
                               class="form-label fw-semibold">

                            Status

                        </label>


                        <select name="Status"
                                id="Status"
                                class="form-select">

                            <option value="">
                                All Status
                            </option>


                            @foreach (
                                var item
                                in Enum.GetValues<EmployeeStatus>())
                            {
                                if (status == (int)item)
                                {
                                    <option value="@((int)item)"
                                            selected>

                                        @item

                                    </option>
                                }
                                else
                                {
                                    <option value="@((int)item)">

                                        @item

                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- =================================================
                         HIRE DATE FROM
                    ================================================== -->

                    <div class="col-md-6 col-lg-2">

                        <label for="HireDateFrom"
                               class="form-label fw-semibold">

                            Hire Date From

                        </label>


                        <input type="date"
                               id="HireDateFrom"
                               name="HireDateFrom"
                               value="@(hireDateFrom?.ToString("yyyy-MM-dd"))"
                               class="form-control" />

                    </div>


                    <!-- =================================================
                         HIRE DATE TO
                    ================================================== -->

                    <div class="col-md-6 col-lg-2">

                        <label for="HireDateTo"
                               class="form-label fw-semibold">

                            Hire Date To

                        </label>


                        <input type="date"
                               id="HireDateTo"
                               name="HireDateTo"
                               value="@(hireDateTo?.ToString("yyyy-MM-dd"))"
                               class="form-control" />

                    </div>


                    <!-- =================================================
                         PAGE SIZE
                    ================================================== -->

                    <div class="col-md-6 col-lg-2">

                        <label for="PageSize"
                               class="form-label fw-semibold">

                            Page Size

                        </label>


                        <select name="PageSize"
                                id="PageSize"
                                class="form-select">

                            @foreach (var size in new[] { 10, 25, 50, 100 })
                            {
                                if (Model.PageSize == size)
                                {
                                    <option value="@size"
                                            selected>

                                        @size

                                    </option>
                                }
                                else
                                {
                                    <option value="@size">

                                        @size

                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- =================================================
                         ACTION BUTTONS
                    ================================================== -->

                    <div class="col-12">

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    id="btnSearch"
                                    class="btn btn-primary">

                                <i class="bi bi-search me-1"></i>

                                <span class="search-button-text">
                                    Search
                                </span>

                            </button>


                            <a asp-controller="Employees"
                               asp-action="Index"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-arrow-counterclockwise me-1"></i>

                                Reset

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- ============================================================
         AJAX RESULTS
    ============================================================= -->

 <div id="employeeResultsWrapper"
     class="position-relative">

    <div id="employeeLoading"
         class="position-absolute top-0 start-0
                w-100 h-100
                d-none
                align-items-center
                justify-content-center"
         style="z-index: 10;
                background: rgba(255,255,255,0.7);">

        <div class="text-center">

            <div class="spinner-border text-primary"
                 role="status">

                <span class="visually-hidden">
                    Loading...
                </span>

            </div>

            <div class="mt-2 text-muted small">
                Loading employees...
            </div>

        </div>

    </div>


    <div id="employeeResults">

        @await Html.PartialAsync(
            "_EmployeeResults",
            Model)

    </div>

</div>

</div>


<!-- ================================================================
     JAVASCRIPT
================================================================= -->

@section Scripts {

    <script>

     document.addEventListener(
    "DOMContentLoaded",
    function () {

        const form =
            document.getElementById(
                "employeeSearchForm"
            );

        const resultsContainer =
            document.getElementById(
                "employeeResults"
            );

        const loading =
            document.getElementById(
                "employeeLoading"
            );

        const departmentSelect =
            document.getElementById(
                "DepartmentId"
            );

        const positionSelect =
            document.getElementById(
                "PositionId"
            );

        const searchInput =
            document.getElementById(
                "Search"
            );

        const searchButton =
            document.getElementById(
                "btnSearch"
            );


        if (
            !form ||
            !resultsContainer
        ) {
            return;
        }


        /* ============================================================
           STATE
        ============================================================= */

        let currentRequest = null;

        let searchTimer = null;


        /* ============================================================
           LOADING
        ============================================================= */

        function setLoading(
            isLoading
        ) {

            if (isLoading) {

                if (loading) {

                    loading.classList.remove(
                        "d-none"
                    );

                    loading.classList.add(
                        "d-flex"
                    );

                }


                resultsContainer.style.minHeight =
                    "250px";


                if (searchButton) {

                    searchButton.disabled =
                        true;


                    const buttonText =
                        searchButton.querySelector(
                            ".search-button-text"
                        );


                    if (buttonText) {

                        buttonText.textContent =
                            "Searching...";

                    }

                }

            }
            else {

                if (loading) {

                    loading.classList.remove(
                        "d-flex"
                    );

                    loading.classList.add(
                        "d-none"
                    );

                }


                resultsContainer.style.minHeight =
                    "";


                if (searchButton) {

                    searchButton.disabled =
                        false;


                    const buttonText =
                        searchButton.querySelector(
                            ".search-button-text"
                        );


                    if (buttonText) {

                        buttonText.textContent =
                            "Search";

                    }

                }

            }

        }


        /* ============================================================
           DEPARTMENT → POSITION
        ============================================================= */

        function filterPositions() {

            if (
                !departmentSelect ||
                !positionSelect
            ) {
                return;
            }


            const selectedDepartmentId =
                departmentSelect.value;


            const positionOptions =
                positionSelect.querySelectorAll(
                    "option[data-department-id]"
                );


            positionOptions.forEach(
                function (option) {

                    const positionDepartmentId =
                        option.getAttribute(
                            "data-department-id"
                        );


                    if (
                        selectedDepartmentId === ""
                    ) {

                        option.hidden =
                            false;

                        return;

                    }


                    option.hidden =
                        positionDepartmentId !==
                        selectedDepartmentId;

                }
            );


            const selectedOption =
                positionSelect.options[
                    positionSelect.selectedIndex
                ];


            if (
                selectedOption &&
                selectedOption.dataset.departmentId &&
                selectedDepartmentId !== "" &&
                selectedOption.dataset.departmentId !==
                    selectedDepartmentId
            ) {

                positionSelect.value = "";

            }

        }


        /* ============================================================
           LOAD EMPLOYEES
        ============================================================= */

        async function loadEmployees(
            page = 1
        ) {

            if (currentRequest) {

                currentRequest.abort();

            }


            currentRequest =
                new AbortController();


            const formData =
                new FormData(form);


            formData.set(
                "PageNumber",
                page
            );


            const params =
                new URLSearchParams(
                    formData
                );


            const url =
                '@Url.Action("Search", "Employees")'
                + "?"
                + params.toString();


            try {

                setLoading(true);


                const response =
                    await fetch(
                        url,
                        {
                            method: "GET",

                            headers: {
                                "X-Requested-With":
                                    "XMLHttpRequest"
                            },

                            signal:
                                currentRequest.signal
                        }
                    );


                if (!response.ok) {

                    throw new Error(
                        `HTTP ${response.status}`
                    );

                }


                const html =
                    await response.text();


                resultsContainer.innerHTML =
                    html;


                bindResultEvents();

            }
            catch (error) {

                if (
                    error.name ===
                    "AbortError"
                ) {

                    return;

                }


                console.error(
                    error
                );


                resultsContainer.innerHTML = `

                    <div class="alert alert-danger shadow-sm">

                        <div class="d-flex align-items-center">

                            <i class="bi
                                      bi-exclamation-triangle
                                      fs-4
                                      me-3">
                            </i>

                            <div>

                                <div class="fw-semibold">
                                    Unable to load employees
                                </div>

                                <div class="small">
                                    Please try again.
                                </div>

                            </div>

                        </div>

                    </div>

                `;

            }
            finally {

                currentRequest =
                    null;

                setLoading(false);

            }

        }


        /* ============================================================
           SEARCH FORM
        ============================================================= */

        form.addEventListener(
            "submit",
            function (event) {

                event.preventDefault();


                clearTimeout(
                    searchTimer
                );


                loadEmployees(1);

            }
        );


        /* ============================================================
           DEBOUNCED TEXT SEARCH
        ============================================================= */

        if (searchInput) {

            searchInput.addEventListener(
                "input",
                function () {

                    clearTimeout(
                        searchTimer
                    );


                    const value =
                        searchInput.value.trim();


                    if (
                        value.length === 0
                    ) {

                        loadEmployees(1);

                        return;

                    }


                    if (
                        value.length < 2
                    ) {

                        return;

                    }


                    searchTimer =
                        setTimeout(
                            function () {

                                loadEmployees(1);

                            },
                            500
                        );

                }
            );

        }


        /* ============================================================
           DEPARTMENT
        ============================================================= */

        if (departmentSelect) {

            departmentSelect.addEventListener(
                "change",
                function () {

                    filterPositions();

                    loadEmployees(1);

                }
            );

        }


        /* ============================================================
           OTHER FILTERS
        ============================================================= */

        const filterIds = [

            "EmploymentType",

            "Status",

            "HireDateFrom",

            "HireDateTo",

            "PageSize"

        ];


        filterIds.forEach(
            function (id) {

                const element =
                    document.getElementById(
                        id
                    );


                if (!element) {
                    return;
                }


                element.addEventListener(
                    "change",
                    function () {

                        loadEmployees(1);

                    }
                );

            }
        );


        /* ============================================================
           POSITION
        ============================================================= */

        if (positionSelect) {

            positionSelect.addEventListener(
                "change",
                function () {

                    loadEmployees(1);

                }
            );

        }


        /* ============================================================
           SORTING + PAGINATION
        ============================================================= */

        function bindResultEvents() {


            /*
             * Pagination
             */

            const pageLinks =
                resultsContainer.querySelectorAll(
                    ".ajax-page-link"
                );


            pageLinks.forEach(
                function (link) {

                    link.addEventListener(
                        "click",
                        function (event) {

                            event.preventDefault();


                            const page =
                                parseInt(
                                    link.dataset.page
                                );


                            if (
                                !isNaN(page)
                            ) {

                                loadEmployees(
                                    page
                                );

                            }

                        }
                    );

                }
            );


            /*
             * Sorting
             */

            const sortLinks =
                resultsContainer.querySelectorAll(
                    ".sort-link"
                );


            sortLinks.forEach(
                function (link) {

                    link.addEventListener(
                        "click",
                        function (event) {

                            event.preventDefault();


                            const sortBy =
                                link.dataset.sortBy;


                            const sortByInput =
                                form.querySelector(
                                    '[name="SortBy"]'
                                );


                            const sortDescendingInput =
                                form.querySelector(
                                    '[name="SortDescending"]'
                                );


                            if (
                                !sortByInput ||
                                !sortDescendingInput
                            ) {
                                return;
                            }


                            if (
                                sortByInput.value
                                    .toLowerCase() ===
                                sortBy.toLowerCase()
                            ) {

                                sortDescendingInput.value =
                                    sortDescendingInput
                                        .value
                                        .toLowerCase() ===
                                    "true"
                                        ? "false"
                                        : "true";

                            }
                            else {

                                sortByInput.value =
                                    sortBy;

                                sortDescendingInput.value =
                                    "true";

                            }


                            loadEmployees(1);

                        }
                    );

                }
            );

        }


        /* ============================================================
           INITIALIZE
        ============================================================= */

        filterPositions();

        bindResultEvents();

    }
);

    </script>

}