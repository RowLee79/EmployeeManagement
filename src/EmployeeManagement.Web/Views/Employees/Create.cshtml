```cshtml
@using EmployeeManagement.Domain.Enums
@using EmployeeManagement.Application.Positions.Interfaces
@model EmployeeManagement.Application.Employees.Models.EmployeeCreateModel

@{
    ViewData["Title"] = "Create Employee";
}

<div class="page-header">
    <div>
        <h1>Create Employee</h1>
        <p>Add a new employee to the organization.</p>
    </div>

    <div>
        <a asp-action="Index"
           class="btn btn-light">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Employees
        </a>
    </div>
</div>

<form asp-action="Create"
      method="post"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>

    <!-- ============================================ -->
    <!-- PROFILE -->
    <!-- ============================================ -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-transparent border-0 pt-4 px-4">
            <h5 class="mb-1">
                <i class="bi bi-person-badge me-2"></i>
                Employee Profile
            </h5>

            <p class="text-muted mb-0">
                Upload an optional employee profile image.
            </p>
        </div>

        <div class="card-body px-4">

            <div class="row align-items-center g-4">

                <div class="col-md-auto">

                    <div class="employee-profile-upload">

                        <div id="profilePreviewContainer"
                             class="employee-profile-preview">

                            <div id="profilePlaceholder"
                                 class="employee-profile-placeholder">

                                <i class="bi bi-person"></i>

                            </div>

                            <img id="profilePreview"
                                 src="#"
                                 alt="Profile preview"
                                 style="display: none;" />

                        </div>

                    </div>

                </div>

                <div class="mb-3">
                    <label asp-for="ProfileImageFile" class="form-label">
                        Profile Image
                    </label>

                    <input asp-for="ProfileImageFile"
                           type="file"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp" />

                    <div class="form-text">
                        JPG, JPEG, PNG or WEBP. Maximum 5 MB.
                    </div>

                    <span asp-validation-for="ProfileImageFile"
                          class="text-danger">
                    </span>
                </div>

            </div>

        </div>

    </div>


    <!-- ============================================ -->
    <!-- PERSONAL INFORMATION -->
    <!-- ============================================ -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-transparent border-0 pt-4 px-4">

            <h5 class="mb-1">
                <i class="bi bi-person me-2"></i>
                Personal Information
            </h5>

            <p class="text-muted mb-0">
                Basic employee information.
            </p>

        </div>

        <div class="card-body px-4">

            <div class="row g-3">

                <!-- First Name -->
                <div class="col-md-4">

                    <label asp-for="FirstName"
                           class="form-label">

                        First Name
                        <span class="text-danger">*</span>

                    </label>

                    <input asp-for="FirstName"
                           class="form-control"
                           placeholder="Enter first name" />

                    <span asp-validation-for="FirstName"
                          class="text-danger">
                    </span>

                </div>


                <!-- Middle Name -->
                <div class="col-md-4">

                    <label asp-for="MiddleName"
                           class="form-label">

                        Middle Name

                    </label>

                    <input asp-for="MiddleName"
                           class="form-control"
                           placeholder="Enter middle name" />

                    <span asp-validation-for="MiddleName"
                          class="text-danger">
                    </span>

                </div>


                <!-- Last Name -->
                <div class="col-md-4">

                    <label asp-for="LastName"
                           class="form-label">

                        Last Name
                        <span class="text-danger">*</span>

                    </label>

                    <input asp-for="LastName"
                           class="form-control"
                           placeholder="Enter last name" />

                    <span asp-validation-for="LastName"
                          class="text-danger">
                    </span>

                </div>


                <!-- Suffix -->
                <div class="col-md-3">

                    <label asp-for="Suffix"
                           class="form-label">

                        Suffix

                    </label>

                    <select asp-for="Suffix"
                            class="form-select">

                        <option value="">
                            None
                        </option>

                        <option value="Jr.">
                            Jr.
                        </option>

                        <option value="Sr.">
                            Sr.
                        </option>

                        <option value="II">
                            II
                        </option>

                        <option value="III">
                            III
                        </option>

                        <option value="IV">
                            IV
                        </option>

                    </select>

                    <span asp-validation-for="Suffix"
                          class="text-danger">
                    </span>

                </div>


                <!-- Birth Date -->
                <div class="col-md-3">

                    <label asp-for="BirthDate"
                           class="form-label">

                        Birth Date
                        <span class="text-danger">*</span>

                    </label>

                    <input asp-for="BirthDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="BirthDate"
                          class="text-danger">
                    </span>

                </div>


                <!-- Gender -->
                <div class="col-md-3">

                    <label asp-for="Gender"
                           class="form-label">

                        Gender
                        <span class="text-danger">*</span>

                    </label>

                    <select asp-for="Gender"
                            asp-items="Html.GetEnumSelectList<Gender>()"
                            class="form-select">

                        <option value="">
                            Select gender
                        </option>

                    </select>

                    <span asp-validation-for="Gender"
                          class="text-danger">
                    </span>

                </div>


                <!-- Civil Status -->
                <div class="col-md-3">

                    <label asp-for="CivilStatus"
                           class="form-label">

                        Civil Status

                    </label>

                    <select asp-for="CivilStatus"
                            class="form-select">

                        <option value="">
                            Select civil status
                        </option>

                        <option value="Single">
                            Single
                        </option>

                        <option value="Married">
                            Married
                        </option>

                        <option value="Widowed">
                            Widowed
                        </option>

                        <option value="Separated">
                            Separated
                        </option>

                    </select>

                    <span asp-validation-for="CivilStatus"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================ -->
    <!-- CONTACT INFORMATION -->
    <!-- ============================================ -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-transparent border-0 pt-4 px-4">

            <h5 class="mb-1">
                <i class="bi bi-telephone me-2"></i>
                Contact Information
            </h5>

            <p class="text-muted mb-0">
                Employee contact and address details.
            </p>

        </div>

        <div class="card-body px-4">

            <div class="row g-3">

                <!-- Email -->
                <div class="col-md-6">

                    <label asp-for="Email"
                           class="form-label">

                        Email Address
                        <span class="text-danger">*</span>

                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-envelope"></i>
                        </span>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="employee@example.com" />

                    </div>

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                <!-- Phone -->
                <div class="col-md-6">

                    <label asp-for="PhoneNumber"
                           class="form-label">

                        Phone Number

                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-telephone"></i>
                        </span>

                        <input asp-for="PhoneNumber"
                               type="tel"
                               class="form-control"
                               placeholder="09XX XXX XXXX" />

                    </div>

                    <span asp-validation-for="PhoneNumber"
                          class="text-danger">
                    </span>

                </div>


                <!-- Address -->
                <div class="col-12">

                    <label asp-for="Address"
                           class="form-label">

                        Address

                    </label>

                    <textarea asp-for="Address"
                              class="form-control"
                              rows="3"
                              placeholder="Enter complete address">
                    </textarea>

                    <span asp-validation-for="Address"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================ -->
    <!-- EMPLOYMENT INFORMATION -->
    <!-- ============================================ -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-transparent border-0 pt-4 px-4">

            <h5 class="mb-1">
                <i class="bi bi-briefcase me-2"></i>
                Employment Information
            </h5>

            <p class="text-muted mb-0">
                Position, department, employment type and salary.
            </p>

        </div>

        <div class="card-body px-4">

            <div class="row g-3">

                <!-- Department -->
                <div class="col-md-6">

                    <label asp-for="DepartmentId"
                           class="form-label">

                        Department
                        <span class="text-danger">*</span>

                    </label>

                    <select asp-for="DepartmentId"
                            id="DepartmentId"
                            class="form-select">

                        <option value="">
                            Select department
                        </option>

                        @if (ViewBag.Departments is not null)
                        {
                            foreach (var department
                                in ViewBag.Departments)
                            {
                                <option value="@department.Id">
                                    @department.Name
                                </option>
                            }
                        }

                    </select>

                    <span asp-validation-for="DepartmentId"
                          class="text-danger">
                    </span>

                </div>


                <!-- Position -->
                <div class="col-md-6">

                    <label asp-for="PositionId"
                           class="form-label">

                        Position
                        <span class="text-danger">*</span>

                    </label>

                    <select asp-for="PositionId"
                            id="PositionId"
                            class="form-select"
                            disabled>

                        <option value="">
                            Select department first
                        </option>

                    </select>

                    <span asp-validation-for="PositionId"
                          class="text-danger">
                    </span>

                    <div id="positionLoading"
                         class="form-text"
                         style="display: none;">

                        <i class="bi bi-arrow-repeat"></i>
                        Loading positions...

                    </div>

                </div>


                <!-- Employment Type -->
                <div class="col-md-4">

                    <label asp-for="EmploymentType"
                           class="form-label">

                        Employment Type
                        <span class="text-danger">*</span>

                    </label>

                    <select asp-for="EmploymentType"
                            asp-items="Html.GetEnumSelectList<EmploymentType>()"
                            class="form-select">

                        <option value="">
                            Select employment type
                        </option>

                    </select>

                    <span asp-validation-for="EmploymentType"
                          class="text-danger">
                    </span>

                </div>


                <!-- Hire Date -->
                <div class="col-md-4">

                    <label asp-for="HireDate"
                           class="form-label">

                        Hire Date
                        <span class="text-danger">*</span>

                    </label>

                    <input asp-for="HireDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="HireDate"
                          class="text-danger">
                    </span>

                </div>


                <!-- Regularization Date -->
                <div class="col-md-4">

                    <label asp-for="RegularizationDate"
                           class="form-label">

                        Regularization Date

                    </label>

                    <input asp-for="RegularizationDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="RegularizationDate"
                          class="text-danger">
                    </span>

                </div>


                <!-- Status -->
                <div class="col-md-6">

                    <label asp-for="Status"
                           class="form-label">

                        Employee Status
                        <span class="text-danger">*</span>

                    </label>

                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<EmployeeStatus>()"
                            class="form-select">

                        <option value="">
                            Select status
                        </option>

                    </select>

                    <span asp-validation-for="Status"
                          class="text-danger">
                    </span>

                </div>


                <!-- Basic Salary -->
                <div class="col-md-6">

                    <label asp-for="BasicSalary"
                           class="form-label">

                        Basic Salary
                        <span class="text-danger">*</span>

                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            ₱
                        </span>

                        <input asp-for="BasicSalary"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               placeholder="0.00" />

                    </div>

                    <span asp-validation-for="BasicSalary"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================ -->
    <!-- FORM ACTIONS -->
    <!-- ============================================ -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="d-flex flex-column flex-sm-row
                justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-light">

                    <i class="bi bi-x-lg me-1"></i>
                    Cancel

                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-lg me-1"></i>
                    Save Employee

                </button>

            </div>

        </div>

    </div>

</form>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            // ==========================================
            // PROFILE IMAGE PREVIEW
            // ==========================================

            const profileInput =
                document.getElementById("ProfileImage");

            const profilePreview =
                document.getElementById("profilePreview");

            const profilePlaceholder =
                document.getElementById("profilePlaceholder");

            if (profileInput) {

                profileInput.addEventListener(
                    "change",
                    function (event) {

                        const file =
                            event.target.files[0];

                        if (!file) {

                            profilePreview.style.display =
                                "none";

                            profilePlaceholder.style.display =
                                "flex";

                            return;
                        }

                        const allowedTypes = [
                            "image/jpeg",
                            "image/png",
                            "image/webp"
                        ];

                        if (!allowedTypes.includes(
                            file.type)) {

                            alert(
                                "Please select a JPG, PNG or WebP image."
                            );

                            profileInput.value = "";

                            profilePreview.style.display =
                                "none";

                            profilePlaceholder.style.display =
                                "flex";

                            return;
                        }

                        const maxSize =
                            5 * 1024 * 1024;

                        if (file.size > maxSize) {

                            alert(
                                "Profile image cannot exceed 5 MB."
                            );

                            profileInput.value = "";

                            profilePreview.style.display =
                                "none";

                            profilePlaceholder.style.display =
                                "flex";

                            return;
                        }

                        const reader =
                            new FileReader();

                        reader.onload =
                            function (e) {

                                profilePreview.src =
                                    e.target.result;

                                profilePreview.style.display =
                                    "block";

                                profilePlaceholder.style.display =
                                    "none";
                            };

                        reader.readAsDataURL(file);
                    });
            }


            // ==========================================
            // DEPARTMENT → POSITION
            // ==========================================

            const departmentSelect =
                document.getElementById(
                    "DepartmentId");

            const positionSelect =
                document.getElementById(
                    "PositionId");

            const positionLoading =
                document.getElementById(
                    "positionLoading");


            async function loadPositions(
                departmentId) {

                positionSelect.innerHTML =
                    '<option value="">Loading positions...</option>';

                positionSelect.disabled = true;

                positionLoading.style.display =
                    "block";


                if (!departmentId) {

                    positionSelect.innerHTML =
                        '<option value="">Select department first</option>';

                    positionLoading.style.display =
                        "none";

                    return;
                }


                try {

                    const response =
                        await fetch(
                            `/Positions/ByDepartment?departmentId=${encodeURIComponent(departmentId)}`
                        );


                    if (!response.ok) {

                        throw new Error(
                            "Unable to load positions."
                        );
                    }


                    const positions =
                        await response.json();


                    positionSelect.innerHTML =
                        '<option value="">Select position</option>';


                    if (positions.length === 0) {

                        positionSelect.innerHTML =
                            '<option value="">No positions available</option>';

                        positionSelect.disabled = true;

                        return;
                    }


                    positions.forEach(function (position) {

                        const option =
                            document.createElement(
                                "option");

                        option.value =
                            position.id;

                        option.textContent =
                            position.name;

                        positionSelect.appendChild(
                            option);
                    });


                    positionSelect.disabled =
                        false;

                }
                catch (error) {

                    console.error(error);

                    positionSelect.innerHTML =
                        '<option value="">Unable to load positions</option>';

                    positionSelect.disabled =
                        true;
                }
                finally {

                    positionLoading.style.display =
                        "none";
                }
            }


            if (departmentSelect) {

                departmentSelect.addEventListener(
                    "change",
                    function () {

                        loadPositions(
                            this.value);
                    });
            }

        });

    </script>
}
```
