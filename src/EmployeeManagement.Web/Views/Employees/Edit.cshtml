```cshtml
@using EmployeeManagement.Application.Departments.Models
@using EmployeeManagement.Application.Positions.Interfaces
@using EmployeeManagement.Application.Positions.Models
@using EmployeeManagement.Domain.Enums

@model EmployeeManagement.Application.Employees.Models.EmployeeEditModel

@{
    ViewData["Title"] = "Edit Employee";

    var departments =
        ViewBag.Departments as IReadOnlyList<DepartmentLookup>
        ?? Array.Empty<DepartmentLookup>();

    var positions =
        ViewBag.Positions as IReadOnlyList<PositionListModel>
        ?? Array.Empty<PositionListModel>();

    var employeeId = ViewBag.EmployeeId;

    string GetInitials()
    {
        var first = Model.FirstName?.FirstOrDefault();
        var last = Model.LastName?.FirstOrDefault();

        return $"{first}{last}".ToUpperInvariant();
    }
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-person-gear me-2"></i>
                Edit Employee
            </h2>

            <p class="text-muted mb-0">
                Update employee information and profile photo.
            </p>
        </div>

        <div>
            <a asp-action="Details"
               asp-route-id="@employeeId"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Back to Details
            </a>
        </div>

    </div>


    <!-- Validation Summary -->
    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>


    <form asp-action="Edit"
          asp-route-id="@employeeId"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div class="row g-4">

            <!-- LEFT COLUMN -->
            <div class="col-lg-4">

                <!-- Profile Card -->
                <div class="card border-0 shadow-sm h-100">

                    <div class="card-header bg-white border-0 pt-4 px-4">
                        <h5 class="fw-semibold mb-0">
                            <i class="bi bi-camera me-2"></i>
                            Profile Photo
                        </h5>
                    </div>

                    <div class="card-body text-center px-4">

                        <!-- Image Preview -->
                        <div class="mb-4">

                            @if (!string.IsNullOrWhiteSpace(Model.ProfileImage))
                            {
                                <img id="profilePreview"
                                     src="@Model.ProfileImage"
                                     alt="Employee Profile"
                                     class="rounded-circle shadow-sm border"
                                     style="
                                width: 180px;
                                height: 180px;
                                object-fit: cover;
                                " />
                            }
                            else
                            {
                                <div id="profilePlaceholder"
                                     class="rounded-circle d-flex align-items-center justify-content-center mx-auto shadow-sm border bg-light"
                                     style="
                                    width: 180px;
                                    height: 180px;
                                    font-size: 3rem;
                                    font-weight: 600;
                                    color: #6c757d;
                                    ">
                                    @GetInitials()
                                </div>

                                <img id="profilePreview"
                                     src=""
                                     alt="Profile Preview"
                                     class="rounded-circle shadow-sm border d-none"
                                     style="
                                width: 180px;
                                height: 180px;
                                object-fit: cover;
                                " />
                            }

                        </div>


                        <!-- File Upload -->
                        <div class="mb-3 text-start">

                            <label asp-for="ProfileImageFile"
                                   class="form-label fw-semibold">

                                Profile Image

                            </label>

                            <input asp-for="ProfileImageFile"
                                   type="file"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   id="profileImageInput" />

                            <span asp-validation-for="ProfileImageFile"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                JPG, JPEG, PNG or WEBP.
                                Maximum size: 5 MB.
                            </div>

                        </div>


                        <!-- Remove Image -->
                        @if (!string.IsNullOrWhiteSpace(Model.ProfileImage))
                        {
                            <div class="form-check text-start mt-3">

                                <input class="form-check-input"
                                       type="checkbox"
                                       id="removeProfileImage"
                                       name="RemoveProfileImage"
                                       value="true" />

                                <label class="form-check-label"
                                       for="removeProfileImage">

                                    Remove current profile image

                                </label>

                            </div>
                        }

                    </div>

                </div>

            </div>


            <!-- RIGHT COLUMN -->
            <div class="col-lg-8">

                <!-- Personal Information -->
                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-0 pt-4 px-4">

                        <h5 class="fw-semibold mb-0">
                            <i class="bi bi-person me-2"></i>
                            Personal Information
                        </h5>

                    </div>

                    <div class="card-body px-4">

                        <div class="row g-3">

                            <!-- Employee Number -->
                            <div class="col-md-6">

                                <label asp-for="EmployeeNumber"
                                       class="form-label fw-semibold">

                                    Employee Number

                                </label>

                                <input asp-for="EmployeeNumber"
                                       class="form-control"
                                       readonly />

                            </div>


                            <!-- Email -->
                            <div class="col-md-6">

                                <label asp-for="Email"
                                       class="form-label fw-semibold">

                                    Email
                                    <span class="text-danger">*</span>

                                </label>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       autocomplete="email" />

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- First Name -->
                            <div class="col-md-4">

                                <label asp-for="FirstName"
                                       class="form-label fw-semibold">

                                    First Name
                                    <span class="text-danger">*</span>

                                </label>

                                <input asp-for="FirstName"
                                       class="form-control"
                                       autocomplete="given-name" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Middle Name -->
                            <div class="col-md-4">

                                <label asp-for="MiddleName"
                                       class="form-label fw-semibold">

                                    Middle Name

                                </label>

                                <input asp-for="MiddleName"
                                       class="form-control" />

                                <span asp-validation-for="MiddleName"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Last Name -->
                            <div class="col-md-4">

                                <label asp-for="LastName"
                                       class="form-label fw-semibold">

                                    Last Name
                                    <span class="text-danger">*</span>

                                </label>

                                <input asp-for="LastName"
                                       class="form-control"
                                       autocomplete="family-name" />

                                <span asp-validation-for="LastName"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Suffix -->
                            <div class="col-md-4">

                                <label asp-for="Suffix"
                                       class="form-label fw-semibold">

                                    Suffix

                                </label>

                                <input asp-for="Suffix"
                                       class="form-control"
                                       placeholder="Jr., Sr., III..." />

                                <span asp-validation-for="Suffix"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Birth Date -->
                            <div class="col-md-4">

                                <label asp-for="BirthDate"
                                       class="form-label fw-semibold">

                                    Birth Date
                                    <span class="text-danger">*</span>

                                </label>

                                <input asp-for="BirthDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="BirthDate"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Gender -->
                            <div class="col-md-4">

                                <label asp-for="Gender"
                                       class="form-label fw-semibold">

                                    Gender
                                    <span class="text-danger">*</span>

                                </label>

                                <select asp-for="Gender"
                                        class="form-select"
                                        asp-items="Html.GetEnumSelectList<Gender>()">

                                    <option value="">
                                        -- Select Gender --
                                    </option>

                                </select>

                                <span asp-validation-for="Gender"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Civil Status -->
                            <div class="col-md-4">

                                <label asp-for="CivilStatus"
                                       class="form-label fw-semibold">

                                    Civil Status

                                </label>

                                <select asp-for="CivilStatus"
                                        class="form-select">

                                    <option value="">
                                        -- Select Civil Status --
                                    </option>

                                    <option value="Single">
                                        Single
                                    </option>

                                    <option value="Married">
                                        Married
                                    </option>

                                    <option value="Widowed">
                                        Widowed
                                    </option>

                                    <option value="Separated">
                                        Separated
                                    </option>

                                    <option value="Divorced">
                                        Divorced
                                    </option>

                                </select>

                                <span asp-validation-for="CivilStatus"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Phone -->
                            <div class="col-md-4">

                                <label asp-for="PhoneNumber"
                                       class="form-label fw-semibold">

                                    Phone Number

                                </label>

                                <input asp-for="PhoneNumber"
                                       class="form-control"
                                       autocomplete="tel" />

                                <span asp-validation-for="PhoneNumber"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Address -->
                            <div class="col-md-8">

                                <label asp-for="Address"
                                       class="form-label fw-semibold">

                                    Address

                                </label>

                                <input asp-for="Address"
                                       class="form-control"
                                       autocomplete="street-address" />

                                <span asp-validation-for="Address"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Employment Information -->
                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-0 pt-4 px-4">

                        <h5 class="fw-semibold mb-0">
                            <i class="bi bi-briefcase me-2"></i>
                            Employment Information
                        </h5>

                    </div>

                    <div class="card-body px-4">

                        <div class="row g-3">

                            <!-- Department -->
                            <div class="col-md-6">

                                <label asp-for="DepartmentId"
                                       class="form-label fw-semibold">

                                    Department
                                    <span class="text-danger">*</span>

                                </label>

                                <select asp-for="DepartmentId"
                                        class="form-select"
                                        id="departmentSelect">

                                    <option value="">
                                        -- Select Department --
                                    </option>
                                    @foreach (var department in departments)
                                    {
                                        <option value="@department.Id">
                                            @department.Name
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="DepartmentId"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Position -->
                            <div class="col-md-6">

                                <label asp-for="PositionId"
                                       class="form-label fw-semibold">

                                    Position
                                    <span class="text-danger">*</span>

                                </label>

                                <select asp-for="PositionId"
                                        class="form-select"
                                        id="positionSelect">

                                    <option value="">
                                        -- Select Position --
                                    </option>

                                    @foreach (var position in positions)
                                    {
                                        <option value="@position.Id">
                                            @position.Code -
                                            @position.Name
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="PositionId"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Employment Type -->
                            <div class="col-md-4">

                                <label asp-for="EmploymentType"
                                       class="form-label fw-semibold">

                                    Employment Type
                                    <span class="text-danger">*</span>

                                </label>

                                <select asp-for="EmploymentType"
                                        class="form-select"
                                        asp-items="Html.GetEnumSelectList<EmploymentType>()">

                                    <option value="">
                                        -- Select Employment Type --
                                    </option>

                                </select>

                                <span asp-validation-for="EmploymentType"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Status -->
                            <div class="col-md-4">

                                <label asp-for="Status"
                                       class="form-label fw-semibold">

                                    Status
                                    <span class="text-danger">*</span>

                                </label>

                                <select asp-for="Status"
                                        class="form-select"
                                        asp-items="Html.GetEnumSelectList<EmployeeStatus>()">

                                    <option value="">
                                        -- Select Status --
                                    </option>

                                </select>

                                <span asp-validation-for="Status"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Basic Salary -->
                            <div class="col-md-4">

                                <label asp-for="BasicSalary"
                                       class="form-label fw-semibold">

                                    Basic Salary
                                    <span class="text-danger">*</span>

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        ₱
                                    </span>

                                    <input asp-for="BasicSalary"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control" />

                                </div>

                                <span asp-validation-for="BasicSalary"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Hire Date -->
                            <div class="col-md-6">

                                <label asp-for="HireDate"
                                       class="form-label fw-semibold">

                                    Hire Date
                                    <span class="text-danger">*</span>

                                </label>

                                <input asp-for="HireDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="HireDate"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Regularization Date -->
                            <div class="col-md-6">

                                <label asp-for="RegularizationDate"
                                       class="form-label fw-semibold">

                                    Regularization Date

                                </label>

                                <input asp-for="RegularizationDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="RegularizationDate"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Actions -->
                <div class="card border-0 shadow-sm">

                    <div class="card-body px-4 py-3">

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Details"
                               asp-route-id="@employeeId"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-x-lg me-1"></i>
                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-check-lg me-1"></i>
                                Save Changes

                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const imageInput =
                document.getElementById("profileImageInput");

            const preview =
                document.getElementById("profilePreview");

            const placeholder =
                document.getElementById("profilePlaceholder");

            const departmentSelect =
                document.getElementById("departmentSelect");

            const positionSelect =
                document.getElementById("positionSelect");


            // ============================================
            // PROFILE IMAGE PREVIEW
            // ============================================

            if (imageInput) {

                imageInput.addEventListener("change", function (event) {

                    const file =
                        event.target.files[0];

                    if (!file)
                        return;


                    // Validate file type
                    const allowedTypes = [
                        "image/jpeg",
                        "image/png",
                        "image/webp"
                    ];

                    if (!allowedTypes.includes(file.type)) {

                        alert(
                            "Please select a JPG, PNG or WEBP image."
                        );

                        imageInput.value = "";

                        return;
                    }


                    // Validate file size - 5 MB
                    const maxSize =
                        5 * 1024 * 1024;

                    if (file.size > maxSize) {

                        alert(
                            "The selected image cannot exceed 5 MB."
                        );

                        imageInput.value = "";

                        return;
                    }


                    const reader =
                        new FileReader();


                    reader.onload = function (e) {

                        if (preview) {

                            preview.src =
                                e.target.result;

                            preview.classList.remove(
                                "d-none"
                            );
                        }


                        if (placeholder) {

                            placeholder.classList.add(
                                "d-none"
                            );
                        }

                    };


                    reader.readAsDataURL(file);

                });

            }


            // ============================================
            // REMOVE PROFILE IMAGE
            // ============================================

            const removeImageCheckbox =
                document.getElementById(
                    "removeProfileImage"
                );

            if (removeImageCheckbox) {

                removeImageCheckbox.addEventListener(
                    "change",
                    function () {

                        if (this.checked) {

                            if (preview) {

                                preview.classList.add(
                                    "opacity-50"
                                );

                            }

                        }
                        else {

                            if (preview) {

                                preview.classList.remove(
                                    "opacity-50"
                                );

                            }

                        }

                    }
                );

            }


            // ============================================
            // DEPARTMENT → POSITION
            // ============================================

            if (departmentSelect) {

                departmentSelect.addEventListener(
                    "change",
                    async function () {

                        const departmentId =
                            this.value;

                        positionSelect.innerHTML =
                            '<option value="">-- Select Position --</option>';


                        if (!departmentId)
                            return;


                        try {

                            positionSelect.disabled =
                                true;


                            const response =
                                await fetch(
                                    `/Employees/ByDepartment?departmentId=${departmentId}`
                                );


                            if (!response.ok) {

                                throw new Error(
                                    "Unable to load positions."
                                );

                            }


                            const positions =
                                await response.json();


                            positions.forEach(
                                function (position) {

                                    const option =
                                        document.createElement(
                                            "option"
                                        );

                                    option.value =
                                        position.id;

                                    option.textContent =
                                        `${position.code} - ${position.name}`;

                                    positionSelect.appendChild(
                                        option
                                    );

                                }
                            );

                        }
                        catch (error) {

                            console.error(error);

                            alert(
                                "Unable to load positions."
                            );

                        }
                        finally {

                            positionSelect.disabled =
                                false;

                        }

                    }
                );

            }

        });

    </script>
}
