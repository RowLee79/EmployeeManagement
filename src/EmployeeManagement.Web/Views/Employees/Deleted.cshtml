@using EmployeeManagement.Application.Employees.Models
@model IReadOnlyList<EmployeeListModel>

@{
    ViewData["Title"] = "Deleted Employees";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-trash3-fill text-danger"></i>
                Deleted Employees
            </h2>

            <p class="text-muted mb-0">
                Employees that have been moved to the recycle bin.
            </p>
        </div>

        <div>
            <a asp-controller="Employees"
               asp-action="Index"
               class="btn btn-outline-primary">

                <i class="bi bi-people-fill"></i>
                Active Employees

            </a>
        </div>

    </div>


    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Information Alert -->
    <div class="alert alert-warning d-flex align-items-start gap-3"
         role="alert">

        <div>
            <i class="bi bi-exclamation-triangle-fill fs-4"></i>
        </div>

        <div>

            <strong>Recycle Bin</strong>

            <div class="small mt-1">
                Deleted employees are kept here until they are restored
                or permanently deleted.
            </div>

        </div>

    </div>


    <!-- Employee List -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="mb-0 fw-bold">
                        Deleted Employees
                    </h5>

                    <small class="text-muted">
                        @Model.Count employee(s)
                    </small>
                </div>

                <span class="badge bg-danger">
                    <i class="bi bi-trash3-fill"></i>
                    Recycle Bin
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Count == 0)
            {
                <!-- Empty State -->
                <div class="text-center py-5">

                    <div class="mb-3">

                        <i class="bi bi-trash3 display-1 text-muted"></i>

                    </div>

                    <h5 class="fw-bold">
                        Recycle Bin is Empty
                    </h5>

                    <p class="text-muted mb-4">
                        There are currently no deleted employees.
                    </p>

                    <a asp-action="Index"
                       class="btn btn-primary">

                        <i class="bi bi-people-fill"></i>
                        Go to Employees

                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th style="width: 70px;">
                                    #
                                </th>

                                <th>
                                    Employee
                                </th>

                                <th>
                                    Employee Number
                                </th>

                                <th>
                                    Department
                                </th>

                                <th>
                                    Position
                                </th>

                                <th>
                                    Employment Type
                                </th>

                                <th>
                                    Hire Date
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-center"
                                    style="width: 180px;">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                var rowNumber = 1;
                            }

                            @foreach (var employee in Model)
                            {
                                var profileImage =
                                    string.IsNullOrWhiteSpace(employee.ProfileImage)
                                        ? Url.Content("~/images/default-avatar.png")
                                        : employee.ProfileImage;

                                <tr>

                                    <!-- Row Number -->
                                    <td class="text-muted">
                                        @rowNumber
                                    </td>


                                    <!-- Employee -->
                                    <td>

                                        <div class="d-flex align-items-center">

                                            <img src="@profileImage"
                                                 alt="@employee.FullName"
                                                 class="rounded-circle me-3 border"
                                                 style="width:45px;height:45px;object-fit:cover;" />

                                            <div>

                                                <div class="fw-semibold">
                                                    @employee.FullName
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(employee.Email))
                                                {
                                                    <div class="small text-muted">
                                                        @employee.Email
                                                    </div>
                                                }

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Employee Number -->
                                    <td>

                                        <span class="fw-semibold">
                                            @employee.EmployeeNumber
                                        </span>

                                    </td>


                                    <!-- Department -->
                                    <td>
                                        @employee.DepartmentName
                                    </td>


                                    <!-- Position -->
                                    <td>
                                        @employee.PositionName
                                    </td>


                                    <!-- Employment Type -->
                                    <td>

                                        <span class="badge bg-secondary">

                                            @employee.EmploymentType

                                        </span>

                                    </td>


                                    <!-- Hire Date -->
                                    <td>

                                        @employee.HireDate.ToString("dd-MMM-yyyy")

                                    </td>


                                    <!-- Status -->
                                    <td>

                                        <span class="badge bg-danger">

                                            <i class="bi bi-trash3-fill"></i>
                                            Deleted

                                        </span>

                                    </td>


                                    <!-- Actions -->
                                    <td>

                                        <div class="d-flex justify-content-center gap-1">

                                            <!-- Details -->
                                            <a asp-controller="Employees"
                                               asp-action="DeletedDetails"
                                               asp-route-id="@employee.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="View Deleted Employee">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <!-- Restore -->
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-success restore-employee-btn"
                                                    data-id="@employee.Id"
                                                    data-name="@employee.FullName"
                                                    title="Restore Employee">

                                                <i class="bi bi-arrow-counterclockwise"></i>

                                            </button>


                                            <!-- Permanent Delete -->
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger permanent-delete-btn"
                                                    data-id="@employee.Id"
                                                    data-name="@employee.FullName"
                                                    title="Permanently Delete">

                                                <i class="bi bi-trash3"></i>

                                            </button>

                                        </div>

                                    </td>

                                </tr>

                                rowNumber++;
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- RESTORE EMPLOYEE MODAL -->
<!-- ========================================================= -->

<div class="modal fade"
     id="restoreEmployeeModal"
     tabindex="-1"
     aria-labelledby="restoreEmployeeModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="restoreEmployeeModalLabel">

                    <i class="bi bi-arrow-counterclockwise text-success"></i>

                    Restore Employee

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                <p class="mb-3">
                    Are you sure you want to restore this employee?
                </p>

                <div class="alert alert-success">

                    <i class="bi bi-person-check-fill me-2"></i>

                    <strong id="restoreEmployeeName">
                    </strong>

                </div>

                <p class="text-muted small mb-0">

                    The employee will be moved back to the
                    <strong>Active Employees</strong> list.

                </p>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancel

                </button>


                <form id="restoreEmployeeForm"
                      asp-controller="Employees"
                      asp-action="Restore"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           id="restoreEmployeeId"
                           name="id" />

                    <button type="submit"
                            class="btn btn-success">

                        <i class="bi bi-arrow-counterclockwise"></i>

                        Restore Employee

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- PERMANENT DELETE MODAL -->
<!-- ========================================================= -->

<div class="modal fade"
     id="permanentDeleteModal"
     tabindex="-1"
     aria-labelledby="permanentDeleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header bg-danger text-white">

                <h5 class="modal-title"
                    id="permanentDeleteModalLabel">

                    <i class="bi bi-exclamation-triangle-fill me-2"></i>

                    Permanent Delete

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                <p>
                    Are you sure you want to permanently delete:
                </p>


                <div class="alert alert-danger">

                    <i class="bi bi-person-x-fill me-2"></i>

                    <strong id="permanentDeleteEmployeeName">
                    </strong>

                </div>


                <div class="alert alert-warning mb-0">

                    <i class="bi bi-exclamation-circle-fill me-2"></i>

                    <strong>Warning:</strong>

                    This action cannot be undone.

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancel

                </button>


                <form id="permanentDeleteForm"
                      asp-controller="Employees"
                      asp-action="PermanentlyDelete"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           id="permanentDeleteEmployeeId"
                           name="id" />

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash3-fill"></i>

                        Permanently Delete

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            /*
             * =====================================================
             * RESTORE EMPLOYEE
             * =====================================================
             */

            const restoreModalElement =
                document.getElementById("restoreEmployeeModal");

            const restoreModal =
                restoreModalElement
                    ? new bootstrap.Modal(restoreModalElement)
                    : null;


            document.addEventListener("click", function (event) {

                const button =
                    event.target.closest(".restore-employee-btn");

                if (!button) {
                    return;
                }


                const employeeId =
                    button.dataset.id;

                const employeeName =
                    button.dataset.name;


                document.getElementById(
                    "restoreEmployeeId"
                ).value = employeeId;


                document.getElementById(
                    "restoreEmployeeName"
                ).textContent = employeeName;


                if (restoreModal) {
                    restoreModal.show();
                }

            });


            /*
             * =====================================================
             * PERMANENT DELETE
             * =====================================================
             */

            const permanentDeleteModalElement =
                document.getElementById("permanentDeleteModal");

            const permanentDeleteModal =
                permanentDeleteModalElement
                    ? new bootstrap.Modal(permanentDeleteModalElement)
                    : null;


            document.addEventListener("click", function (event) {

                const button =
                    event.target.closest(".permanent-delete-btn");

                if (!button) {
                    return;
                }


                const employeeId =
                    button.dataset.id;

                const employeeName =
                    button.dataset.name;


                document.getElementById(
                    "permanentDeleteEmployeeId"
                ).value = employeeId;


                document.getElementById(
                    "permanentDeleteEmployeeName"
                ).textContent = employeeName;


                if (permanentDeleteModal) {
                    permanentDeleteModal.show();
                }

            });

        });

    </script>

}