@using EmployeeManagement.Application.LeaveManagement.Models
@using EmployeeManagement.Domain.Enums

@model LeaveRequestCreateModel

@{
    ViewData["Title"] = "New Leave Request";

    var employees = ViewBag.Employees
        as IReadOnlyList<EmployeeManagement.Application.Employees.Models.EmployeeListModel>
        ?? Array.Empty<EmployeeManagement.Application.Employees.Models.EmployeeListModel>();
}

<div class="page-header">

    <div>
        <h1 class="page-title">
            New Leave Request
        </h1>

        <p class="text-muted mb-0">
            Create an employee leave request.
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>

        Back

    </a>

</div>

<div class="card shadow-sm border-0 mt-4">

    <div class="card-body">

        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <div class="row g-4">

                <div class="col-md-6">

                    <label asp-for="EmployeeId"
                           class="form-label">
                        Employee
                    </label>

                    <select asp-for="EmployeeId"
                            class="form-select">

                        <option value="">
                            Select employee
                        </option>

                        @foreach (var employee in employees)
                        {
                            <option value="@employee.Id">
                                @employee.EmployeeNumber -
                                @employee.FullName
                            </option>
                        }

                    </select>

                    <span asp-validation-for="EmployeeId"
                          class="text-danger"></span>

                </div>

                <div class="col-md-6">

                    <label asp-for="LeaveType"
                           class="form-label">
                        Leave Type
                    </label>

                    <select asp-for="LeaveType"
                            asp-items="Html.GetEnumSelectList<LeaveType>()"
                            class="form-select">
                    </select>

                    <span asp-validation-for="LeaveType"
                          class="text-danger"></span>

                </div>

                <div class="col-md-6">

                    <label asp-for="StartDate"
                           class="form-label">
                        Start Date
                    </label>

                    <input asp-for="StartDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="StartDate"
                          class="text-danger"></span>

                </div>

                <div class="col-md-6">

                    <label asp-for="EndDate"
                           class="form-label">
                        End Date
                    </label>

                    <input asp-for="EndDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="EndDate"
                          class="text-danger"></span>

                </div>

                <div class="col-12">

                    <label asp-for="Reason"
                           class="form-label">
                        Reason
                    </label>

                    <textarea asp-for="Reason"
                              rows="5"
                              class="form-control"
                              placeholder="Enter the reason for leave..."></textarea>

                    <span asp-validation-for="Reason"
                          class="text-danger"></span>

                </div>

            </div>

            <div class="alert alert-info mt-4">

                <i class="bi bi-info-circle me-2"></i>

                Total leave days are calculated automatically.
                Weekends are excluded.

            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">

                <a asp-action="Index"
                   class="btn btn-light">

                    Cancel

                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-send me-1"></i>

                    Submit Request

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}