@model EmployeeManagement.Application.Dashboard.Models.DashboardModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="d-flex flex-wrap
        justify-content-between
        align-items-center
        gap-3 mb-4">

        <div>

            <h1 class="h3 mb-1">
                Dashboard
            </h1>

            <p class="text-muted mb-0">
                Employee Management System overview
            </p>

        </div>

        <div class="text-muted small">

            <i class="bi bi-calendar3 me-1"></i>

            @DateTime.Now.ToString("MMMM dd, yyyy")

        </div>

    </div>


    <!-- =====================================================
         EMPLOYEE KPI CARDS
         ===================================================== -->

    <div class="row g-4 mb-4">

        <!-- Total Employees -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-start">

                        <div>

                            <div class="text-muted small mb-2">
                                Total Employees
                            </div>

                            <div class="display-6 fw-bold">
                                @Model.TotalEmployees
                            </div>

                        </div>

                        <div class="dashboard-icon">
                            <i class="bi bi-people-fill"></i>
                        </div>

                    </div>

                    <div class="mt-3 text-muted small">

                        <i class="bi bi-person-check me-1"></i>

                        @Model.ActiveEmployees active

                    </div>

                </div>

            </div>

        </div>


        <!-- Active Employees -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-start">

                        <div>

                            <div class="text-muted small mb-2">
                                Active Employees
                            </div>

                            <div class="display-6 fw-bold">
                                @Model.ActiveEmployees
                            </div>

                        </div>

                        <div class="dashboard-icon">
                            <i class="bi bi-person-check-fill"></i>
                        </div>

                    </div>

                    <div class="mt-3 text-success small">

                        <i class="bi bi-check-circle me-1"></i>

                        Currently active

                    </div>

                </div>

            </div>

        </div>


        <!-- Departments -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-start">

                        <div>

                            <div class="text-muted small mb-2">
                                Departments
                            </div>

                            <div class="display-6 fw-bold">
                                @Model.TotalDepartments
                            </div>

                        </div>

                        <div class="dashboard-icon">
                            <i class="bi bi-diagram-3-fill"></i>
                        </div>

                    </div>

                    <div class="mt-3 text-muted small">

                        @Model.TotalPositions active positions

                    </div>

                </div>

            </div>

        </div>


        <!-- Pending Leave -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-start">

                        <div>

                            <div class="text-muted small mb-2">
                                Pending Leaves
                            </div>

                            <div class="display-6 fw-bold">
                                @Model.PendingLeaveRequests
                            </div>

                        </div>

                        <div class="dashboard-icon">
                            <i class="bi bi-calendar-heart-fill"></i>
                        </div>

                    </div>

                    <div class="mt-3 text-warning small">

                        <i class="bi bi-clock me-1"></i>

                        Awaiting approval

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         ATTENDANCE
         ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header
            bg-transparent
            border-0
            pt-4
            px-4">

            <div>

                <h5 class="mb-1">
                    Today's Attendance
                </h5>

                <p class="text-muted small mb-0">
                    Attendance status for today
                </p>

            </div>

        </div>


        <div class="card-body px-4">

            <div class="row g-3">

                <!-- Present -->

                <div class="col-xl col-md-4 col-6">

                    <div class="attendance-stat">

                        <div class="attendance-stat-icon">
                            <i class="bi bi-check-circle"></i>
                        </div>

                        <div>

                            <div class="attendance-stat-value">
                                @Model.PresentToday
                            </div>

                            <div class="attendance-stat-label">
                                Present
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Late -->

                <div class="col-xl col-md-4 col-6">

                    <div class="attendance-stat">

                        <div class="attendance-stat-icon">
                            <i class="bi bi-clock"></i>
                        </div>

                        <div>

                            <div class="attendance-stat-value">
                                @Model.LateToday
                            </div>

                            <div class="attendance-stat-label">
                                Late
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Absent -->

                <div class="col-xl col-md-4 col-6">

                    <div class="attendance-stat">

                        <div class="attendance-stat-icon">
                            <i class="bi bi-x-circle"></i>
                        </div>

                        <div>

                            <div class="attendance-stat-value">
                                @Model.AbsentToday
                            </div>

                            <div class="attendance-stat-label">
                                Absent
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Half Day -->

                <div class="col-xl col-md-4 col-6">

                    <div class="attendance-stat">

                        <div class="attendance-stat-icon">
                            <i class="bi bi-hourglass-split"></i>
                        </div>

                        <div>

                            <div class="attendance-stat-value">
                                @Model.HalfDayToday
                            </div>

                            <div class="attendance-stat-label">
                                Half Day
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Leave -->

                <div class="col-xl col-md-4 col-6">

                    <div class="attendance-stat">

                        <div class="attendance-stat-icon">
                            <i class="bi bi-calendar-heart"></i>
                        </div>

                        <div>

                            <div class="attendance-stat-value">
                                @Model.OnLeaveToday
                            </div>

                            <div class="attendance-stat-label">
                                On Leave
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         CHART + RECENT EMPLOYEES
         ===================================================== -->

    <div class="row g-4">

        <!-- Department Chart -->

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header
                    bg-transparent
                    border-0
                    pt-4
                    px-4">

                    <h5 class="mb-1">
                        Employees by Department
                    </h5>

                    <p class="text-muted small mb-0">
                        Current employee distribution
                    </p>

                </div>

                <div class="card-body">

                    <canvas id="departmentChart"
                            height="280">
                    </canvas>

                </div>

            </div>

        </div>


        <!-- Recent Employees -->

        <div class="col-lg-5">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header
                    bg-transparent
                    border-0
                    pt-4
                    px-4">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>

                            <h5 class="mb-1">
                                Recent Employees
                            </h5>

                            <p class="text-muted small mb-0">
                                Recently added employees
                            </p>

                        </div>

                        <a asp-controller="Employees"
                           asp-action="Index"
                           class="btn btn-sm
                            btn-outline-primary">

                            View All

                        </a>

                    </div>

                </div>


                <div class="card-body p-0">

                    @if (Model.RecentEmployees.Count == 0)
                    {
                        <div class="text-center
                            text-muted
                            py-5">

                            <i class="bi bi-people fs-2"></i>

                            <div class="mt-2">
                                No employees found.
                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="list-group
                            list-group-flush">

                            @foreach (
                                var employee
                                in Model.RecentEmployees)
                            {
                                <a asp-controller="Employees"
                                   asp-action="Details"
                                   asp-route-id="@employee.Id"
                                   class="list-group-item
                                    list-group-item-action
                                    border-0
                                    px-4
                                    py-3">

                                    <div class="d-flex
                                        align-items-center
                                        gap-3">

                                        <div class="avatar avatar-sm">

                                            @{
                                                var parts =
                                                    employee.FullName
                                                        .Split(
                                                            ' ',
                                                            StringSplitOptions
                                                                .RemoveEmptyEntries);

                                                var initials =
                                                    parts.Length >= 2
                                                        ? $"{parts[0][0]}{parts[^1][0]}"
                                                        : parts[0][0]
                                                            .ToString();

                                                initials =
                                                    initials.ToUpper();
                                            }

                                            <span>
                                                @initials
                                            </span>

                                        </div>


                                        <div class="flex-grow-1">

                                            <div class="fw-semibold">
                                                @employee.FullName
                                            </div>

                                            <div class="text-muted small">

                                                @employee.EmployeeNumber

                                                @if (!string.IsNullOrWhiteSpace(
                                                    employee.DepartmentName))
                                                {
                                                    <span>
                                                        ·
                                                        @employee.DepartmentName
                                                    </span>
                                                }

                                            </div>

                                        </div>


                                        <div class="text-end">

                                            <div class="small">
                                                @(employee.HireDate.ToString("MMM dd, yyyy"))
                                            </div>

                                            <span class="badge
                                                text-bg-success
                                                mt-1">

                                                @employee.Status

                                            </span>

                                        </div>

                                    </div>

                                </a>
                            }

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>
        const departmentLabels = [
                    @foreach (var item in Model.EmployeesByDepartment)
            {
                @: '@Html.Raw(
                                    System.Text.Encodings.Web.JavaScriptEncoder
                                            .Default
                                            .Encode(item.DepartmentName)
                                        )',
                        }
        ];

            const departmentValues = [
                            @foreach (var item in Model.EmployeesByDepartment)
                {
                    @: @item.EmployeeCount,
                }
                    ];

            const chartElement =
                document.getElementById('departmentChart');

            if (chartElement) {

                new Chart(
                    chartElement,
                    {
                        type: 'doughnut',

                        data: {
                            labels: departmentLabels,

                            datasets: [
                                {
                                    data: departmentValues
                                }
                            ]
                        },

                        options: {
                            responsive: true,

                            maintainAspectRatio: false,

                            plugins: {
                                legend: {
                                    position: 'bottom'
                                }
                            }
                        }
                    }
                );
            }
        </script>

    }